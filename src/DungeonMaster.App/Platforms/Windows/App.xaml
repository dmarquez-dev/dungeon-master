<maui:MauiWinUIApplication
    x:Class="DungeonMaster.App.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maui="using:Microsoft.Maui"
    xmlns:local="using:DungeonMaster.App.WinUI">

    <!--
        This dictionary is parsed by WinUI, not by MAUI, so MAUI's merged
        Application.Resources (Resources/Theme/Tokens.xaml and friends) are NOT in scope
        here: a StaticResource reference to a Dm token compiles but throws on first
        lookup, and the value would be a Microsoft.Maui.Graphics.Color rather than the
        Windows.UI.Color that SolidColorBrush.Color requires.

        Every brush this application overrides is therefore built in App.xaml.cs from
        DmColors via DmColors.ToPlatform. Do not reintroduce colour literals here.

        The empty dictionary below is load-bearing: if Application.Resources is never set
        from XAML the native getter fails with E_FAIL, so the code-behind has nothing to
        populate.
    -->
    <Application.Resources>
        <ResourceDictionary />
    </Application.Resources>

</maui:MauiWinUIApplication>
