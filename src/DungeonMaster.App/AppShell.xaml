<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DungeonMaster.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:DungeonMaster.App.Views">

    <!-- No Title on the Shell: on Windows it renders as a text run in the app's title bar, and
         the app already names itself in the flag banner at the top of every page. The ShellContent
         Title below is the route's own name, not chrome, and stays. -->

    <ShellContent
        Title="Dungeons"
        ContentTemplate="{DataTemplate views:DungeonListPage}"
        Route="DungeonListPage" />

</Shell>
