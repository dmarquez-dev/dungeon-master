<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DungeonMaster.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:DungeonMaster.App.Views">

    <!-- No Title on the Shell. The window's title, set in App.CreateWindow, is what names the app
         in the title bar; a Shell Title would add a second text run beside it. The ShellContent
         Title below is the route's own name, not chrome, and stays. -->

    <ShellContent
        Title="Dungeons"
        ContentTemplate="{DataTemplate views:DungeonListPage}"
        Route="DungeonListPage" />

</Shell>
