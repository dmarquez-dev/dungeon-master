<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-windows10.0.19041.0;net10.0-maccatalyst</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>DungeonMaster.App</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Compile a {Binding} that carries an explicit Source against THAT source's type
		     instead of against the enclosing x:DataType. Without it the binding generator
		     applies the ambient DataType to every binding in scope, so
		     `{Binding ButtonRowSpacing, Source={x:Reference Chrome}}` is compiled against the
		     view model, which has no such property. See CreateDungeonPopup.xaml. -->
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

		<!-- Display name -->
		<ApplicationTitle>DungeonMaster.App</ApplicationTitle>

		<!-- App Identifier. Was the .NET template's com.companyname.dungeonmaster.app.
		     "companyname" is not a defensible identity for a shipped app, so it is replaced
		     with the reverse-DNS form of the GitHub owner (dmarquez-dev; hyphens are not legal
		     in every platform's package identifier, hence dmarquezdev).

		     THIS IS AN IDENTITY DECISION AND MAY WANT TO BE SOMETHING ELSE. Changing it after
		     a build has been installed makes the next one a DIFFERENT application to Windows,
		     which gets its own local app-data folder — and the SQLite database lives there, so
		     an existing install stops seeing its dungeons. Nothing has shipped yet, so the cost
		     is zero today and rises the moment it does. -->
		<ApplicationId>com.dmarquezdev.dungeonmaster</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon.
		     #1A1208 is the app's own background — the same value the theme holds under
		     DmSurfaceTavern — replacing the .NET template's #512BD4 purple, which was a
		     framework default on a parchment-and-tavern app. It has to be a literal for the
		     same reason the splash colour below is: MSBuild evaluates this before and outside
		     MAUI, with no access to Resources/Theme/Tokens.xaml, so it cannot reference the
		     token. Changing it regenerates the icon assets. If DmSurfaceTavern moves, move
		     this and the splash by hand. -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1A1208" />

		<!-- Splash Screen.
		     #1A1208 is the app's own background — the same value the theme holds under
		     DmSurfaceTavern — replacing the .NET template's #512BD4 purple. It has to be a
		     literal: MSBuild evaluates this before and outside MAUI, with no access to
		     Resources/Theme/Tokens.xaml, so it cannot reference the token. Nothing scans
		     this file for raw colours either; the theme hygiene tests read *.xaml and *.cs
		     only. If DmSurfaceTavern moves, move this by hand. -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1A1208" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts. The wildcard is the registration; do not re-list individual
		     files beside it. An explicit list used to sit here and had already drifted —
		     it omitted rpgawesome-webfont.ttf, reading as an authoritative registry that
		     was missing a font while the wildcard silently kept the app working. -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

		<!-- Object pack assets — logical name includes pack id prefix, e.g. "2_Minute_Tabletop/Objects/furniture/bed.png" -->
		<MauiAsset Include="Resources\Assets\Packs\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" />
		<PackageReference Include="CommunityToolkit.Mvvm" />
		<PackageReference Include="Microsoft.Maui.Controls" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" />
		<PackageReference Include="Plugin.Maui.KeyListener" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\DungeonMaster.Application\DungeonMaster.Application.csproj" />
	  <ProjectReference Include="..\DungeonMaster.App.Core\DungeonMaster.App.Core.csproj" />
	  <ProjectReference Include="..\DungeonMaster.Infrastructure\DungeonMaster.Infrastructure.csproj" />
	</ItemGroup>

</Project>
