<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DungeonMaster.App"
             xmlns:converters="clr-namespace:DungeonMaster.App.Converters"
             x:Class="DungeonMaster.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Order matters: each dictionary may reference keys from those above it. -->
                <ResourceDictionary Source="Resources/Theme/Tokens.xaml" />
                <ResourceDictionary Source="Resources/Theme/Typography.xaml" />
                <ResourceDictionary Source="Resources/Theme/Controls.Base.xaml" />
                <ResourceDictionary Source="Resources/Theme/Controls.Tavern.xaml" />
                <ResourceDictionary Source="Resources/Theme/Controls.Parchment.xaml" />
                <ResourceDictionary Source="Resources/Theme/Controls.Semantic.xaml" />
                <ResourceDictionary Source="Resources/Theme/Implicit.xaml" />
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:NotNullConverter x:Key="NotNullConverter" />
            <converters:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
