<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="DungeonMaster.App.Controls.DmPopup"
    x:Name="Root">

    <Border
        StrokeShape="RoundRectangle 4"
        Stroke="{StaticResource DmBorderParchmentBrush}"
        StrokeThickness="{StaticResource DmStrokeEmphasis}"
        MinimumWidthRequest="300"
        MaximumWidthRequest="420">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{StaticResource DmSurfaceParchment}" Offset="0.0" />
                <GradientStop Color="{StaticResource DmSurfaceParchmentDeep}" Offset="1.0" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid RowDefinitions="Auto,*,Auto">

            <!-- Header bar -->
            <Grid Grid.Row="0" Padding="14,10">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{StaticResource DmAccentGoldLight}" Offset="0.0" />
                        <GradientStop Color="{StaticResource DmAccentGoldDark}" Offset="1.0" />
                    </LinearGradientBrush>
                </Grid.Background>
                <Label
                    Text="{Binding Title, Source={x:Reference Root}}"
                    FontFamily="{StaticResource DmFontTitleDecorative}"
                    FontSize="{StaticResource DmFontSizeTitle}"
                    TextColor="{StaticResource DmTextParchment}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Grid>

            <!-- Body content slot -->
            <ContentView x:Name="BodyPresenter" Grid.Row="1" Padding="18,14" />

            <!-- Bottom scroll bar -->
            <BoxView Grid.Row="2" HeightRequest="5">
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{StaticResource DmAccentGoldDark}" Offset="0.0" />
                        <GradientStop Color="{StaticResource DmAccentGoldLight}" Offset="1.0" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

        </Grid>
    </Border>
</ContentView>
