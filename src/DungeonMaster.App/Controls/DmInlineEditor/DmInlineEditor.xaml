<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:DungeonMaster.App.Behaviors"
    x:Class="DungeonMaster.App.Controls.DmInlineEditor"
    x:Name="Root">

    <!-- FocusBorder lights up gold when the editor is active.
         No BackgroundColor set — a null WinUI background is not hit-testable,
         preventing phantom click capture over the layout area. -->
    <Border
        x:Name="FocusBorder"
        Stroke="Transparent"
        StrokeShape="RoundRectangle 3"
        StrokeThickness="1"
        Padding="2,1">

        <Grid>
            <Label
                x:Name="DisplayLabel"
                FontFamily="{Binding FontFamily, Source={x:Reference Root}}"
                FontSize="{Binding FontSize, Source={x:Reference Root}}"
                TextColor="{StaticResource DMTextPrimary}"
                VerticalOptions="Center">
                <Label.Behaviors>
                    <behaviors:HandCursorBehavior />
                </Label.Behaviors>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLabelTapped" />
                </Label.GestureRecognizers>
            </Label>

            <!--
                Entry: used when AcceptsReturn=False (names, titles — single-line).
                Entry aligns with Label out of the box; Completed fires on Enter (no \r hack).
                IsVisible=False removes it from the tab/focus cycle when inactive.
            -->
            <Entry
                x:Name="EditEntry"
                IsVisible="False"
                VerticalOptions="Center"
                FontFamily="{Binding FontFamily, Source={x:Reference Root}}"
                FontSize="{Binding FontSize, Source={x:Reference Root}}"
                TextColor="{StaticResource DMTextPrimary}"
                BackgroundColor="Transparent"
                PlaceholderColor="{StaticResource DMTextMuted}"
                Focused="OnInputFocused"
                Unfocused="OnEntryUnfocused"
                Completed="OnEntryCompleted" />

            <!--
                Editor: used when AcceptsReturn=True (description, notes — multi-line).
                IsVisible=False removes it from the tab/focus cycle when inactive.
            -->
            <Editor
                x:Name="EditEditor"
                IsVisible="False"
                AutoSize="TextChanges"
                FontFamily="{Binding FontFamily, Source={x:Reference Root}}"
                FontSize="{Binding FontSize, Source={x:Reference Root}}"
                TextColor="{StaticResource DMTextPrimary}"
                BackgroundColor="Transparent"
                PlaceholderColor="{StaticResource DMTextMuted}"
                Focused="OnInputFocused"
                Unfocused="OnEditorUnfocused" />
        </Grid>
    </Border>
</ContentView>
