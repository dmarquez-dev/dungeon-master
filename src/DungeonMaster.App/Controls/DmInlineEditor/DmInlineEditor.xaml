<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:DungeonMaster.App.Behaviors"
    x:Class="DungeonMaster.App.Controls.DmInlineEditor"
    x:Name="Root">

    <!-- FocusBorder: subtle gold border on hover, full gold glow on focus.
         No BackgroundColor set — a null WinUI background is not hit-testable,
         preventing phantom click capture over the layout area. -->
    <Border
        x:Name="FocusBorder"
        Stroke="Transparent"
        StrokeThickness="{StaticResource DmStrokeHairline}"
        Padding="{StaticResource DmPaddingTight}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="{StaticResource DmRadiusDefault}" />
        </Border.StrokeShape>
        <Border.GestureRecognizers>
            <PointerGestureRecognizer
                PointerEntered="OnPointerEntered"
                PointerExited="OnPointerExited" />
        </Border.GestureRecognizers>

        <Grid>
            <!--
                DisplayLabel has no TextColor binding on purpose. Its colour is not TextColor: it
                is TextColor or PlaceholderColor depending on whether the value is empty, and that
                switch lives in SyncDisplay, which is the label's single writer. A binding here
                would be clobbered by the first SyncDisplay under MAUI value precedence and would
                read as though the colour came from markup. FontFamily and FontSize are pass-
                throughs with no such switch, so they stay bound.
            -->
            <Label
                x:Name="DisplayLabel"
                FontFamily="{Binding FontFamily, Source={x:Reference Root}}"
                FontSize="{Binding FontSize, Source={x:Reference Root}}"
                LineBreakMode="TailTruncation"
                VerticalOptions="Center">
                <Label.Behaviors>
                    <behaviors:HandCursorBehavior Shape="IBeam" />
                </Label.Behaviors>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLabelTapped" />
                </Label.GestureRecognizers>
            </Label>

            <!--
                Entry: used when AcceptsReturn=False (names, titles — single-line).
                Opacity/InputTransparent/IsTabStop control visibility so the control always
                participates in layout measurement, keeping the Border height stable between
                hover (label shown) and focus (entry shown) states.
            -->
            <Entry
                x:Name="EditEntry"
                Opacity="0"
                InputTransparent="True"
                VerticalOptions="Center"
                FontFamily="{Binding FontFamily, Source={x:Reference Root}}"
                FontSize="{Binding FontSize, Source={x:Reference Root}}"
                TextColor="{Binding TextColor, Source={x:Reference Root}}"
                BackgroundColor="Transparent"
                PlaceholderColor="{Binding PlaceholderColor, Source={x:Reference Root}}"
                Focused="OnInputFocused"
                Unfocused="OnEntryUnfocused"
                Completed="OnEntryCompleted" />

            <!--
                Editor: used when AcceptsReturn=True (description, notes — multi-line).
                Same opacity-based visibility as Entry above.
            -->
            <Editor
                x:Name="EditEditor"
                Opacity="0"
                InputTransparent="True"
                AutoSize="TextChanges"
                FontFamily="{Binding FontFamily, Source={x:Reference Root}}"
                FontSize="{Binding FontSize, Source={x:Reference Root}}"
                TextColor="{Binding TextColor, Source={x:Reference Root}}"
                BackgroundColor="Transparent"
                PlaceholderColor="{Binding PlaceholderColor, Source={x:Reference Root}}"
                Focused="OnInputFocused"
                Unfocused="OnEditorUnfocused" />
        </Grid>
    </Border>
</ContentView>
