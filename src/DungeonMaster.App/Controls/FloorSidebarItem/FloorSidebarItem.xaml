<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DungeonMaster.App.Controls"
    xmlns:behaviors="clr-namespace:DungeonMaster.App.Behaviors"
    x:Class="DungeonMaster.App.Controls.FloorSidebarItem"
    x:Name="Root">

    <Border
        x:Name="FloorBorder"
        StrokeShape="RoundRectangle 3"
        StrokeThickness="1"
        Stroke="{StaticResource DMCardBorderBrush}"
        BackgroundColor="{StaticResource DMCardSurface}"
        Padding="8,6"
        Margin="0,0,0,4">

        <VerticalStackLayout Spacing="4">
            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCardTapped" />
            </VerticalStackLayout.GestureRecognizers>

            <!-- Header row -->
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="6">

                <!-- Expand toggle (visual indicator only — card tap handles expand) -->
                <Label
                    x:Name="ExpandToggle"
                    Grid.Column="0"
                    Text="&#x25B8;"
                    FontSize="14"
                    TextColor="{StaticResource DMTextMuted}"
                    VerticalOptions="Center" />

                <!-- Floor number (static, muted) -->
                <Label
                    x:Name="FloorNumberLabel"
                    Grid.Column="1"
                    FontFamily="CinzelSemiBold"
                    FontSize="16"
                    TextColor="{StaticResource DMTextMuted}"
                    VerticalOptions="Center" />

                <!-- Floor custom name (display only — edited via toolbar) -->
                <Label
                    x:Name="FloorNameLabel"
                    Grid.Column="2"
                    FontFamily="CinzelSemiBold"
                    FontSize="16"
                    TextColor="{StaticResource DMScrollGoldLight}"
                    VerticalOptions="Center" />

                <!-- Always-visible notebook button — colour reflects whether this floor has authored content -->
                <Button
                    x:Name="NotebookButton"
                    Grid.Column="3"
                    Text="&#xEA8F;"
                    FontFamily="RpgAwesome"
                    FontSize="16"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource DMInkMuted}"
                    Padding="4,2"
                    CornerRadius="2"
                    Clicked="OnNotebookClicked"
                    ToolTipProperties.Text="Open notebook">
                    <Button.Behaviors>
                        <behaviors:HandCursorBehavior />
                    </Button.Behaviors>
                </Button>

                <!-- Delete button -->
                <Button
                    x:Name="DeleteButton"
                    Grid.Column="4"
                    Text="&#xE9FC;"
                    FontFamily="RpgAwesome"
                    FontSize="16"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource DMDestructive}"
                    Padding="4,2"
                    CornerRadius="2"
                    Clicked="OnDeleteClicked"
                    ToolTipProperties.Text="Delete floor">
                    <Button.Behaviors>
                        <behaviors:HandCursorBehavior />
                    </Button.Behaviors>
                </Button>

                <!-- Drag handle -->
                <Label
                    x:Name="DragHandle"
                    Grid.Column="5"
                    Text="&#x22EE;"
                    FontSize="18"
                    TextColor="{StaticResource DMTextMuted}"
                    VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDragHandleTapped" />
                        <DragGestureRecognizer DragStarting="OnDragStarting" DropCompleted="OnDropCompleted" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <!-- Expanded area list -->
            <VerticalStackLayout
                x:Name="AreaContainer"
                IsVisible="False"
                Spacing="0"
                Padding="8,4,0,0" />

            <!-- Add area row (visible when expanded) -->
            <Button
                x:Name="AddAreaButton"
                Text="+ Add area"
                FontFamily="EBGaramondRegular"
                FontSize="16"
                TextColor="{StaticResource DMScrollGoldLight}"
                BackgroundColor="Transparent"
                Padding="8,2"
                HorizontalOptions="Start"
                IsVisible="False"
                Clicked="OnAddAreaClicked">
                <Button.Behaviors>
                    <behaviors:HandCursorBehavior />
                </Button.Behaviors>
            </Button>

        </VerticalStackLayout>

        <Border.GestureRecognizers>
            <PointerGestureRecognizer
                PointerEntered="OnPointerEntered"
                PointerExited="OnPointerExited" />
            <DropGestureRecognizer
                DragOver="OnDragOver"
                DragLeave="OnDragLeave"
                Drop="OnDrop" />
        </Border.GestureRecognizers>
    </Border>
</ContentView>
