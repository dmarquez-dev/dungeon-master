<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DungeonMaster.App.Controls"
    xmlns:behaviors="clr-namespace:DungeonMaster.App.Behaviors"
    xmlns:presentation="clr-namespace:DungeonMaster.App.Core.Presentation;assembly=DungeonMaster.App.Core"
    x:Class="DungeonMaster.App.Controls.FloorSidebarItem"
    x:Name="Root">

    <!-- DmBorderTavernStyle supplies the hairline stroke, the tavern border brush and the
         DmRadiusDefault corner. BackgroundColor is restated because the style inherits
         BackgroundColor="Transparent" from DmBorderBase. Both Stroke and BackgroundColor are the
         FIRST FRAME only: from the first GoToState on, the FloorStates group below owns them, and
         a visual-state setter outranks both a style setter and a local value. -->
    <Border
        x:Name="FloorBorder"
        Style="{StaticResource DmBorderTavernStyle}"
        BackgroundColor="{StaticResource DmSurfaceTavernRaised}"
        Padding="{StaticResource DmPaddingCompact}"
        Margin="0,0,0,4">

        <!-- THE RESTING, HOVER, EXPANDED AND DROP-TARGET APPEARANCE LIVES HERE AND NOWHERE ELSE
             (MASTER-098). It was five imperative writes to BackgroundColor and Stroke, one inside
             SetExpanded and four outside it in the pointer and drag handlers, so two mechanisms
             drove one property and no theme dictionary could reach either.

             The group is named FloorStates rather than CommonStates on purpose: MAUI drives
             CommonStates itself, and its automatic PointerOver would outrank Expanded whenever the
             pointer rested on an open floor. UpdateVisualState in the code-behind is the single
             owner of the transition and states the precedence once: Expanded, then DragOver, then
             Hovered, then Normal. That is what the four "if (!_isExpanded)" and
             "_isExpanded ? ... : ..." guards used to say four times over.

             Every state sets BOTH properties. A state naming only Stroke would let MAUI restore
             BackgroundColor to the attribute above on entry, and the expanded surface would drop
             back to the resting one the moment a drag passed over an open floor. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroupList>
                <VisualStateGroup x:Name="FloorStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource DmSurfaceTavernRaised}" />
                            <Setter Property="Stroke" Value="{StaticResource DmBorderTavernBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Hovered">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource DmSurfaceTavernRaisedHover}" />
                            <Setter Property="Stroke" Value="{StaticResource DmBorderTavernBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Expanded">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource DmSurfaceTavernRaisedActive}" />
                            <Setter Property="Stroke" Value="{StaticResource DmBorderTavernHoverBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="DragOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource DmSurfaceTavernRaised}" />
                            <Setter Property="Stroke" Value="{StaticResource DmBorderTavernHoverBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </VisualStateManager.VisualStateGroups>

        <!-- This layout is the LARGE tap target that expands and collapses the floor, and
             expanding is the only route to a floor's areas. Since MASTER-164 it is no longer the
             ONLY such target — ExpandToggle below is a real Button and does the same job from the
             keyboard — but IT MUST NOT BE REMOVED (contract C3 section 4). The chevron's visual
             is allowed to sit under Microsoft's 23x23 touch minimum only by their redundancy
             carve-out, and THIS gesture is the redundancy that earns it. Delete this recognizer
             and the carve-out no longer applies.

             The card has to be in the accessibility tree and has to say what it is; without a
             description it was an unlabelled target that another control pointed at. The
             description is static because the toggle beside it already carries the
             expanded/collapsed state, rewritten in ApplyExpanded.

             MASTER-161: the behavior gives the pointer the hand cursor over the card body. The
             three Buttons in this file already carried one; the largest clickable surface in the
             sidebar, and the only route to a floor's areas, did not. -->
        <VerticalStackLayout
            Spacing="{StaticResource DmSpaceXS}"
            AutomationId="FloorCard"
            SemanticProperties.Description="Floor card"
            SemanticProperties.Hint="Tap to expand or collapse this floor's areas.">
            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCardTapped" />
            </VerticalStackLayout.GestureRecognizers>
            <VerticalStackLayout.Behaviors>
                <behaviors:HandCursorBehavior />
            </VerticalStackLayout.Behaviors>

            <!-- Header row -->
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="{StaticResource DmSpaceXXS}">

                <!-- Expand toggle. THIS IS A Button AND NOT A Label, AND THAT IS THE WHOLE POINT
                     (MASTER-164). As a Label it took no keyboard focus on WinUI — only
                     Control-derived classes do — and the card body it pointed at is a
                     VerticalStackLayout, which takes no focus either and cannot be made to:
                     IsTabStop/TabIndex/ITabStopElement are absent from .NET MAUI 10's public API
                     and MAUI 9 removed layout focus deliberately. Expanding is the ONLY route to
                     a floor's areas, so the whole sidebar below this row was keyboard-unreachable.
                     A real Button is what Microsoft's keyboard-accessibility guidance prescribes
                     for exactly this shape, and it is what WinUI's own Expander uses.

                     THE FOOTPRINT IS PINNED — contract C3. The user declined this remedy once, at
                     sub-session 5c's escalation E5, because a Button grows the header row. So the
                     glyph keeps the Label's FontFamily and FontSize and the visible chevron is
                     unchanged; the hit area comes from Padding, not from a bigger glyph;
                     Transparent + BorderWidth 0 leave nothing of the button drawn; and Margin is
                     0 because padding is the mechanism and margin is not. Measured at 1920x1080
                     with 11 floors, the rendered button matches the notebook and delete Buttons
                     beside it, so the header row's height is unchanged.

                     The glyph flips between ▸ and ▾ in ApplyExpanded, so the description is
                     rewritten there alongside it; the value here is the collapsed state the glyph
                     starts in. The Hint no longer sends the user to the card — the chevron itself
                     does the job now. -->
                <Button
                    x:Name="ExpandToggle"
                    Grid.Column="0"
                    AutomationId="FloorExpandToggle"
                    Text="&#x25B8;"
                    FontFamily="{StaticResource DmFontBody}"
                    FontSize="{StaticResource DmIconSizeSmall}"
                    TextColor="{StaticResource DmTextTavernMuted}"
                    BackgroundColor="Transparent"
                    BorderWidth="0"
                    Margin="0"
                    Padding="{StaticResource DmPaddingCompact}"
                    CornerRadius="{StaticResource DmRadiusTight}"
                    SemanticProperties.Description="Collapsed"
                    SemanticProperties.Hint="Expands or collapses this floor's areas."
                    Clicked="OnExpandToggleClicked"
                    VerticalOptions="Center"
                    ToolTipProperties.Text="Expand or collapse floor">
                    <Button.Behaviors>
                        <behaviors:HandCursorBehavior />
                    </Button.Behaviors>
                </Button>

                <!-- Floor name (or a "Floor N" placeholder when unnamed). Right margin keeps the
                     name clear of the action buttons now that the row is on the tightest spacing step. -->
                <Label
                    x:Name="FloorNameLabel"
                    Grid.Column="1"
                    FontFamily="{StaticResource DmFontTitleStrong}"
                    FontSize="{StaticResource DmFontSizeSubheading}"
                    TextColor="{StaticResource DmAccentGoldLight}"
                    Margin="0,0,6,0"
                    VerticalOptions="Center" />

                <!-- Always-visible notebook button — colour reflects whether this floor has
                     authored content. That colour is the only sighted cue for it, so Populate
                     rewrites the description whenever it rewrites TextColor; the value here is
                     the empty state an unpopulated row shows. -->
                <Button
                    x:Name="NotebookButton"
                    Grid.Column="2"
                    AutomationId="FloorNotebookButton"
                    SemanticProperties.Description="Notebook, empty"
                    SemanticProperties.Hint="Opens the notebook for this floor."
                    Text="&#xEA8F;"
                    FontFamily="{StaticResource DmFontIcon}"
                    FontSize="{StaticResource DmIconSizeMedium}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource DmTextParchmentMuted}"
                    Padding="{StaticResource DmPaddingTight}"
                    CornerRadius="{StaticResource DmRadiusTight}"
                    Clicked="OnNotebookClicked"
                    ToolTipProperties.Text="Open notebook">
                    <Button.Behaviors>
                        <behaviors:HandCursorBehavior />
                    </Button.Behaviors>
                </Button>

                <!-- Delete button -->
                <Button
                    Grid.Column="3"
                    AutomationId="FloorDeleteButton"
                    SemanticProperties.Description="Delete floor"
                    SemanticProperties.Hint="Asks for confirmation, then removes this floor and its areas."
                    Text="&#xE9FC;"
                    FontFamily="{StaticResource DmFontIcon}"
                    FontSize="{StaticResource DmIconSizeMedium}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource DmDestructive}"
                    Padding="{StaticResource DmPaddingTight}"
                    CornerRadius="{StaticResource DmRadiusTight}"
                    Clicked="OnDeleteClicked"
                    ToolTipProperties.Text="Delete floor">
                    <Button.Behaviors>
                        <behaviors:HandCursorBehavior />
                    </Button.Behaviors>
                </Button>

                <!-- Drag handle -->
                <Label
                    Grid.Column="4"
                    AutomationId="FloorDragHandle"
                    Text="&#x22EE;"
                    FontFamily="{StaticResource DmFontBody}"
                    FontSize="{StaticResource DmIconSizeLarge}"
                    TextColor="{StaticResource DmTextTavernMuted}"
                    SemanticProperties.Description="Reorder floor"
                    SemanticProperties.Hint="Drag this handle onto another floor card to change the floor order."
                    VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDragHandleTapped" />
                        <DragGestureRecognizer DragStarting="OnDragStarting" DropCompleted="OnDropCompleted" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <!-- Separator between the floor's own row and its area list; visible only while
                 expanded. The three IsVisible bindings below read IsExpanded straight off this
                 control, so the expanded/collapsed fact has exactly one owner and no handler
                 restates it. -->
            <BoxView
                x:Name="AreaSeparator"
                IsVisible="{Binding IsExpanded, Source={x:Reference Root}}"
                Color="{StaticResource DmHairline}"
                HeightRequest="1" />

            <!-- Expanded area list. The padding indents the area rows under their own floor
                 row and is asymmetric by design: no bottom or right inset, so the Add-area
                 button sits tight beneath the last area and the rows run to the card edge. -->
            <VerticalStackLayout
                x:Name="AreaContainer"
                IsVisible="{Binding IsExpanded, Source={x:Reference Root}}"
                Spacing="0"
                Padding="8,4,0,0"
                BindableLayout.ItemsSource="{Binding Floor.Areas, Source={x:Reference Root}}">

                <!-- MASTER-099. The rows are generated from the bound collection rather than
                     built by hand in RebuildAreas, and each one takes this control's five area
                     commands DIRECTLY. That is what removes the Middle Man: the five Area*
                     events this control used to declare existed only to re-raise the child's
                     five identically-shaped events, and re-wire five closures per child on every
                     Floor assignment. The command travels down a binding now, so nothing in
                     between re-raises anything.

                     RelativeSource rather than x:Reference: a DataTemplate is its own name scope
                     and cannot see the Root name declared outside it. -->
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="presentation:AreaItem">
                        <controls:AreaSidebarItem
                            Area="{Binding .}"
                            SelectCommand="{Binding AreaSelectCommand, Source={RelativeSource AncestorType={x:Type controls:FloorSidebarItem}}}"
                            HoverStartedCommand="{Binding AreaHoverStartedCommand, Source={RelativeSource AncestorType={x:Type controls:FloorSidebarItem}}}"
                            HoverEndedCommand="{Binding AreaHoverEndedCommand, Source={RelativeSource AncestorType={x:Type controls:FloorSidebarItem}}}"
                            DeleteCommand="{Binding AreaDeleteCommand, Source={RelativeSource AncestorType={x:Type controls:FloorSidebarItem}}}"
                            NotebookCommand="{Binding AreaNotebookCommand, Source={RelativeSource AncestorType={x:Type controls:FloorSidebarItem}}}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Add area row (visible when expanded) -->
            <Button
                x:Name="AddAreaButton"
                AutomationId="AddAreaButton"
                Text="+ Add area"
                FontFamily="{StaticResource DmFontBody}"
                FontSize="{StaticResource DmFontSizeBodySmall}"
                TextColor="{StaticResource DmAccentGoldLight}"
                BackgroundColor="Transparent"
                Padding="{StaticResource DmPaddingCompact}"
                HorizontalOptions="Start"
                IsVisible="{Binding IsExpanded, Source={x:Reference Root}}"
                Clicked="OnAddAreaClicked">
                <Button.Behaviors>
                    <behaviors:HandCursorBehavior />
                </Button.Behaviors>
            </Button>

        </VerticalStackLayout>

        <Border.GestureRecognizers>
            <PointerGestureRecognizer
                PointerEntered="OnPointerEntered"
                PointerExited="OnPointerExited" />
            <DropGestureRecognizer
                DragOver="OnDragOver"
                DragLeave="OnDragLeave"
                Drop="OnDrop" />
        </Border.GestureRecognizers>
    </Border>
</ContentView>
