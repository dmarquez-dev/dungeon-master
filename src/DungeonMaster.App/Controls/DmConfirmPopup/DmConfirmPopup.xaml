<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:controls="clr-namespace:DungeonMaster.App.Controls"
    xmlns:behaviors="clr-namespace:DungeonMaster.App.Behaviors"
    x:Class="DungeonMaster.App.Controls.DmConfirmPopup"
    x:TypeArguments="x:Boolean"
    BackgroundColor="Transparent"
    Margin="0"
    Padding="0"
    CanBeDismissedByTappingOutsideOfPopup="True">

    <controls:DmPopup x:Name="Chrome">
        <controls:DmPopup.Body>
            <VerticalStackLayout Spacing="20">

                <Label
                    x:Name="MessageLabel"
                    FontFamily="EBGaramondRegular"
                    FontSize="16"
                    TextColor="{StaticResource DMInk}"
                    LineBreakMode="WordWrap" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button
                        x:Name="CancelButton"
                        Grid.Column="0"
                        FontFamily="CinzelRegular"
                        FontSize="13"
                        CharacterSpacing="1"
                        BackgroundColor="{StaticResource DMNeutralSurface}"
                        TextColor="{StaticResource DMInk}"
                        BorderColor="{StaticResource DMNeutralBorder}"
                        BorderWidth="1.5"
                        CornerRadius="3"
                        Clicked="OnCancel">
                        <Button.Behaviors>
                            <behaviors:HandCursorBehavior />
                        </Button.Behaviors>
                    </Button>
                    <Button
                        x:Name="ConfirmButton"
                        Grid.Column="1"
                        FontFamily="CinzelRegular"
                        FontSize="13"
                        CharacterSpacing="1"
                        CornerRadius="3"
                        Clicked="OnConfirm">
                        <Button.Behaviors>
                            <behaviors:HandCursorBehavior />
                        </Button.Behaviors>
                    </Button>
                </Grid>

            </VerticalStackLayout>
        </controls:DmPopup.Body>
    </controls:DmPopup>

</toolkit:Popup>
