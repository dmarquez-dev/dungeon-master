<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:controls="clr-namespace:DungeonMaster.App.Controls"
    xmlns:behaviors="clr-namespace:DungeonMaster.App.Behaviors"
    x:Class="DungeonMaster.App.Controls.DmConfirmPopup"
    x:TypeArguments="x:Boolean"
    BackgroundColor="Transparent"
    Margin="0"
    Padding="0"
    CanBeDismissedByTappingOutsideOfPopup="True">

    <controls:DmPopup x:Name="Chrome">
        <controls:DmPopup.Body>
            <!-- No Spacing here: DmPopup owns the gap between body sections, so this popup and
                 every other one share it. Setting Spacing would take it back. -->
            <VerticalStackLayout>

                <Label
                    x:Name="MessageLabel"
                    AutomationId="ConfirmPopupMessage"
                    FontFamily="{StaticResource DmFontBody}"
                    FontSize="{StaticResource DmFontSizeBody}"
                    TextColor="{StaticResource DmTextParchment}"
                    LineBreakMode="WordWrap" />

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="{Binding ButtonRowSpacing, Source={x:Reference Chrome}}">
                    <Button
                        x:Name="CancelButton"
                        Grid.Column="0"
                        AutomationId="ConfirmPopupCancelButton"
                        FontFamily="{StaticResource DmFontTitle}"
                        FontSize="{StaticResource DmFontSizeAction}"
                        CharacterSpacing="1"
                        BackgroundColor="{StaticResource DmNeutralSurface}"
                        TextColor="{StaticResource DmTextParchment}"
                        BorderColor="{StaticResource DmNeutralBorder}"
                        BorderWidth="{StaticResource DmStrokeMedium}"
                        CornerRadius="{StaticResource DmRadiusDefault}"
                        Clicked="OnCancel">
                        <Button.Behaviors>
                            <behaviors:HandCursorBehavior />
                        </Button.Behaviors>
                    </Button>
                    <Button
                        x:Name="ConfirmButton"
                        Grid.Column="1"
                        AutomationId="ConfirmPopupConfirmButton"
                        FontFamily="{StaticResource DmFontTitle}"
                        FontSize="{StaticResource DmFontSizeAction}"
                        CharacterSpacing="1"
                        CornerRadius="{StaticResource DmRadiusDefault}"
                        Clicked="OnConfirm">
                        <Button.Behaviors>
                            <behaviors:HandCursorBehavior />
                        </Button.Behaviors>
                    </Button>
                </Grid>

            </VerticalStackLayout>
        </controls:DmPopup.Body>
    </controls:DmPopup>

</toolkit:Popup>
