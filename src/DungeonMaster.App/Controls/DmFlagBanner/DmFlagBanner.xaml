<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
    x:Class="DungeonMaster.App.Controls.DmFlagBanner"
    x:Name="Root">

    <Grid HeightRequest="44" Margin="0,0,0,8">

        <!-- Banner gradient background -->
        <BoxView CornerRadius="0">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="{StaticResource DmSurfaceTavern}" Offset="0.0" />
                    <GradientStop Color="{StaticResource DmBannerEdge}" Offset="0.06" />
                    <GradientStop Color="{StaticResource DmBannerCenter}" Offset="0.35" />
                    <GradientStop Color="{StaticResource DmBannerCenter}" Offset="0.65" />
                    <GradientStop Color="{StaticResource DmBannerEdge}" Offset="0.94" />
                    <GradientStop Color="{StaticResource DmSurfaceTavern}" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- Static title label (default) -->
        <Label
            x:Name="TitleLabel"
            AutomationId="FlagBannerTitle"
            Text="{Binding Title, Source={x:Reference Root}}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            FontFamily="{StaticResource DmFontTitleDecorative}"
            FontSize="{StaticResource DmFontSizeBanner}"
            CharacterSpacing="2"
            TextColor="{StaticResource DmTextTavern}" />

    </Grid>
</ContentView>
