<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="DungeonMaster.App.Controls.DmCard"
    x:Name="Root">

    <Border
        x:Name="CardBorder"
        AutomationId="DmCard"
        StrokeThickness="{StaticResource DmStrokeHairline}"
        Padding="{StaticResource DmPaddingCard}">

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="{StaticResource DmRadiusLoose}" />
        </Border.StrokeShape>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource DmSurfaceTavernRaised}" />
                            <Setter Property="Stroke" Value="{StaticResource DmBorderTavernBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource DmSurfaceTavernRaisedHover}" />
                            <Setter Property="Stroke" Value="{StaticResource DmBorderTavernHoverBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </VisualStateManager.VisualStateGroups>

        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout Grid.Column="0" Spacing="{StaticResource DmSpaceXS}">
                <Label
                    Text="{Binding Title, Source={x:Reference Root}}"
                    FontFamily="{StaticResource DmFontTitleStrong}"
                    FontSize="{StaticResource DmFontSizeTitle}"
                    TextColor="{StaticResource DmTextTavern}" />
                <Label
                    x:Name="SubtitleLabel"
                    Text="{Binding Subtitle, Source={x:Reference Root}}"
                    FontFamily="{StaticResource DmFontBodyItalic}"
                    FontSize="{StaticResource DmFontSizeBody}"
                    TextColor="{StaticResource DmTextTavernMuted}"
                    IsVisible="False" />
            </VerticalStackLayout>
            <ContentView x:Name="TrailingPresenter"
                         Grid.Column="1"
                         VerticalOptions="Center"
                         Margin="10,0,0,0" />
        </Grid>
    </Border>
</ContentView>
