<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="DungeonMaster.App.Controls.DmSearchBar"
    x:Name="Root">

    <!-- BackgroundColor is restated on purpose: DmBorderTavernStyle inherits
         BackgroundColor="Transparent" from DmBorderBase, so a Border with a surface of its own
         has to say so again. The StrokeShape element is kept for the same class of reason — the
         style's inherited shape is DmRadiusDefault (3) and the search field is deliberately on
         DmRadiusLoose (4), matching the cards below it rather than the toolbars. -->
    <Border
        x:Name="SearchBorder"
        Style="{StaticResource DmBorderTavernStyle}"
        BackgroundColor="{StaticResource DmSurfaceTavernRaised}"
        Padding="{StaticResource DmPaddingControl}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="{StaticResource DmRadiusLoose}" />
        </Border.StrokeShape>
        <!-- MinimumHeightRequest is stated here and nowhere else. A control carrying Style= is
             ignored by the implicit Entry style in Implicit.xaml, which is what supplies the
             touch target; adopting DmEntryTavern therefore opts out of it. That floor is
             load-bearing for THIS field specifically — it was measured dropping from 51px to
             42px when the stock styles were deleted (see Implicit.xaml). The floor is restated
             at the call site rather than on DmEntryBase because putting it on the base would
             grow CreateDungeonPopup's Entry and Editor, which have never had a minimum. What
             the call site names is now DmTouchTargetMinimum rather than a literal 44; the
             reasoning above is unchanged, only the source of the number is. -->
        <Entry
            AutomationId="DungeonSearchEntry"
            SemanticProperties.Description="Search dungeons"
            Style="{StaticResource DmEntryTavern}"
            MinimumHeightRequest="{StaticResource DmTouchTargetMinimum}"
            Text="{Binding SearchText, Source={x:Reference Root}, Mode=TwoWay}"
            Placeholder="Search dungeons..."
            Focused="OnSearchFocused"
            Unfocused="OnSearchUnfocused" />
    </Border>
</ContentView>
