<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="DungeonMaster.App.Controls.DmSearchBar"
    x:Name="Root">

    <Border
        x:Name="SearchBorder"
        StrokeShape="RoundRectangle 4"
        StrokeThickness="{StaticResource DmStrokeHairline}"
        Stroke="{StaticResource DmBorderTavernBrush}"
        BackgroundColor="{StaticResource DmSurfaceTavernRaised}"
        Padding="10,4">
        <Entry
            Text="{Binding SearchText, Source={x:Reference Root}, Mode=TwoWay}"
            Placeholder="Search dungeons..."
            PlaceholderColor="{StaticResource DmTextTavernMuted}"
            TextColor="{StaticResource DmTextTavern}"
            BackgroundColor="Transparent"
            FontFamily="{StaticResource DmFontBody}"
            FontSize="{StaticResource DmFontSizeBody}"
            Focused="OnSearchFocused"
            Unfocused="OnSearchUnfocused" />
    </Border>
</ContentView>
