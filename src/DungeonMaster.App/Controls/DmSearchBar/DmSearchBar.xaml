<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="DungeonMaster.App.Controls.DmSearchBar"
    x:Name="Root">

    <Border
        x:Name="SearchBorder"
        StrokeShape="RoundRectangle 4"
        StrokeThickness="1"
        Stroke="{StaticResource DMCardBorderBrush}"
        BackgroundColor="{StaticResource DMCardSurface}"
        Padding="10,4">
        <Border.Shadow>
            <Shadow Brush="{StaticResource DMGoldBrush}"
                    Offset="0,0"
                    Radius="10"
                    Opacity="0" />
        </Border.Shadow>
        <Entry
            Text="{Binding SearchText, Source={x:Reference Root}, Mode=TwoWay}"
            Placeholder="Search dungeons..."
            PlaceholderColor="{StaticResource DMTextMuted}"
            TextColor="{StaticResource DMTextPrimary}"
            BackgroundColor="Transparent"
            FontFamily="EBGaramondRegular"
            FontSize="18"
            Focused="OnSearchFocused"
            Unfocused="OnSearchUnfocused" />
    </Border>
</ContentView>
