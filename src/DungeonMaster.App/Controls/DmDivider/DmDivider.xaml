<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="DungeonMaster.App.Controls.DmDivider"
    x:Name="Root">

    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="{StaticResource DmSpaceMedium}">

        <BoxView Grid.Column="0" HeightRequest="1" VerticalOptions="Center">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="Transparent" Offset="0.0" />
                    <GradientStop Color="{StaticResource DmAccentGoldLight}" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- The ornament's whole label is a glyph. It is decorative, but MAUI has no "ignore
             this" flag that survives the platform mapping, so it announces what it structurally
             is rather than nothing at all. -->
        <Label
            Grid.Column="1"
            Text="&#xEAD4;"
            FontFamily="{StaticResource DmFontIcon}"
            FontSize="{Binding IconFontSize, Source={x:Reference Root}}"
            TextColor="{StaticResource DmAccentGoldLight}"
            SemanticProperties.Description="Section divider"
            VerticalOptions="Center" />

        <BoxView Grid.Column="2" HeightRequest="1" VerticalOptions="Center">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{StaticResource DmAccentGoldLight}" Offset="0.0" />
                    <GradientStop Color="Transparent" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

    </Grid>
</ContentView>
