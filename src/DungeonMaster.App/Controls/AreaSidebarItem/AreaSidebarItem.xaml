<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DungeonMaster.App.Controls"
    xmlns:behaviors="clr-namespace:DungeonMaster.App.Behaviors"
    x:Class="DungeonMaster.App.Controls.AreaSidebarItem"
    x:Name="Root">

    <Border
        x:Name="ItemBorder"
        BackgroundColor="Transparent"
        Stroke="Transparent"
        StrokeThickness="0"
        Padding="4,3">

        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">

            <!-- Diamond bullet -->
            <Label Grid.Column="0"
                   Text="&#x25C6;"
                   FontSize="12"
                   TextColor="{StaticResource DMTextMuted}"
                   VerticalOptions="Center" />

            <!-- Area name (display only — edited via toolbar) -->
            <Label
                x:Name="AreaNameLabel"
                Grid.Column="1"
                FontFamily="EBGaramondRegular"
                FontSize="17"
                TextColor="{StaticResource DMScrollGoldLight}"
                VerticalOptions="Center" />

            <!-- Hover-revealed delete button -->
            <Button
                x:Name="DeleteButton"
                Grid.Column="2"
                Text="&#xE916;"
                FontFamily="RpgAwesome"
                FontSize="16"
                BackgroundColor="Transparent"
                TextColor="{StaticResource DMDestructive}"
                Padding="4,2"
                CornerRadius="2"
                IsVisible="False"
                Clicked="OnDeleteClicked"
                ToolTipProperties.Text="Delete area">
                <Button.Behaviors>
                    <behaviors:HandCursorBehavior />
                </Button.Behaviors>
            </Button>

        </Grid>

        <Border.GestureRecognizers>
            <PointerGestureRecognizer
                PointerEntered="OnPointerEntered"
                PointerExited="OnPointerExited" />
            <TapGestureRecognizer Tapped="OnItemTapped" />
        </Border.GestureRecognizers>
    </Border>
</ContentView>
