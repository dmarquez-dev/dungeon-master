<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DungeonMaster.App.Controls"
    xmlns:behaviors="clr-namespace:DungeonMaster.App.Behaviors"
    x:Class="DungeonMaster.App.Controls.AreaSidebarItem"
    x:Name="Root">

    <Border
        x:Name="ItemBorder"
        BackgroundColor="Transparent"
        Stroke="Transparent"
        StrokeThickness="0"
        Padding="4,3">

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">

            <!-- Diamond bullet -->
            <Label Grid.Column="0"
                   Text="&#x25C6;"
                   FontSize="12"
                   TextColor="{StaticResource DMTextMuted}"
                   VerticalOptions="Center" />

            <!-- Area name (display only — edited via toolbar) -->
            <Label
                x:Name="AreaNameLabel"
                Grid.Column="1"
                FontFamily="EBGaramondRegular"
                FontSize="17"
                TextColor="{StaticResource DMScrollGoldLight}"
                VerticalOptions="Center" />

        </Grid>

        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnItemTapped" />
        </Border.GestureRecognizers>

        <Border.Behaviors>
            <behaviors:HoverOrLongPressBehavior
                HoverEntered="OnHoverEntered"
                HoverExited="OnHoverExited" />
        </Border.Behaviors>
    </Border>
</ContentView>
