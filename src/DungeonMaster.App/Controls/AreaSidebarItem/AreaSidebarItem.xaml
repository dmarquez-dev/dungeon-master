<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DungeonMaster.App.Controls"
    xmlns:behaviors="clr-namespace:DungeonMaster.App.Behaviors"
    x:Class="DungeonMaster.App.Controls.AreaSidebarItem">

    <!-- BackgroundColor, Stroke and StrokeThickness are stated as attributes because they are the
         FIRST FRAME, before any visual state has been entered. From the first GoToState on, the
         SelectionStates group below owns all three. -->
    <Border
        x:Name="ItemBorder"
        AutomationId="AreaRow"
        BackgroundColor="Transparent"
        Stroke="Transparent"
        StrokeThickness="0"
        StrokeShape="Rectangle"
        Padding="{StaticResource DmPaddingTight}">

        <!-- THE SELECTED AND HOVER APPEARANCE LIVES HERE AND NOWHERE ELSE (MASTER-098). It used to
             be six code-behind assignments in SetEditing and the two hover handlers, driven by a
             private bool that no theme dictionary could see, let alone reach.

             The group is named SelectionStates rather than CommonStates on purpose: MAUI drives
             CommonStates itself, and its automatic PointerOver would outrank Selected whenever the
             pointer rested on the focused row. UpdateVisualState in the code-behind is the single
             owner of the transition and states the precedence once: Selected, then Hovered, then
             Normal. That is what the two "if (!_isSelected)" guards used to say twice.

             Stroke takes DmAreaSelectedBorder, which is a Color rather than a Brush.
             BindableProperty.TryConvert widens Color to Brush (measured and recorded in
             TokenTypeMatchesTargetPropertyTests), which is why the old "new SolidColorBrush(...)"
             wrapper is gone rather than moved.

             Every state sets all three properties. A state that named only some of them would let
             MAUI restore the rest to the attributes above on entry, which is the class of bug the
             two mechanisms driving one property used to produce. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroupList>
                <VisualStateGroup x:Name="SelectionStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="Transparent" />
                            <Setter Property="Stroke" Value="Transparent" />
                            <Setter Property="StrokeThickness" Value="0" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Hovered">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource DmGoldHoverTint}" />
                            <Setter Property="Stroke" Value="Transparent" />
                            <Setter Property="StrokeThickness" Value="0" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Selected">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource DmAreaSelectedTint}" />
                            <Setter Property="Stroke" Value="{StaticResource DmAreaSelectedBorder}" />
                            <Setter Property="StrokeThickness" Value="{StaticResource DmStrokeHairline}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </VisualStateManager.VisualStateGroups>

        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{StaticResource DmSpaceXXS}">

            <!-- Diamond bullet. Its whole label is a glyph, so a reader announces nothing
                 without the description; "Area" is what the bullet means, and it lands just
                 before the name that follows it. -->
            <Label Grid.Column="0"
                   Text="&#x25C6;"
                   FontFamily="{StaticResource DmFontBody}"
                   FontSize="{StaticResource DmIconSizeTiny}"
                   TextColor="{StaticResource DmTextTavernMuted}"
                   SemanticProperties.Description="Area"
                   VerticalOptions="Center" />

            <!-- Area name (display only — edited via toolbar). Right margin keeps the name clear
                 of the action buttons now that the row is on the tightest spacing step. -->
            <Label
                x:Name="AreaNameLabel"
                Grid.Column="1"
                FontFamily="{StaticResource DmFontBody}"
                FontSize="{StaticResource DmFontSizeBody}"
                TextColor="{StaticResource DmAccentGoldLight}"
                Margin="0,0,6,0"
                VerticalOptions="Center" />

            <!-- Always-visible notebook button — colour reflects whether this area has authored
                 content. The colour is the ONLY sighted cue for that, so the description carries
                 the same state in words and Populate rewrites it whenever it rewrites TextColor.
                 The value here is the empty state, which is what an unpopulated row shows. -->
            <Button
                x:Name="NotebookButton"
                Grid.Column="2"
                AutomationId="AreaNotebookButton"
                Style="{StaticResource DmIconButton}"
                Text="&#xEA8F;"
                FontFamily="{StaticResource DmFontIcon}"
                FontSize="{StaticResource DmIconSizeSmall}"
                BackgroundColor="Transparent"
                TextColor="{StaticResource DmTextParchmentMuted}"
                Padding="{StaticResource DmPaddingTight}"
                CornerRadius="{StaticResource DmRadiusTight}"
                Clicked="OnNotebookClicked"
                SemanticProperties.Description="Notebook, empty"
                SemanticProperties.Hint="Opens the notebook for this area."
                ToolTipProperties.Text="Open notebook">
                <Button.Behaviors>
                    <behaviors:HandCursorBehavior />
                </Button.Behaviors>
            </Button>

            <!-- Delete button -->
            <Button
                Grid.Column="3"
                AutomationId="AreaDeleteButton"
                Style="{StaticResource DmIconButton}"
                Text="&#xE9FC;"
                FontFamily="{StaticResource DmFontIcon}"
                FontSize="{StaticResource DmIconSizeSmall}"
                BackgroundColor="Transparent"
                TextColor="{StaticResource DmDestructive}"
                Padding="{StaticResource DmPaddingTight}"
                CornerRadius="{StaticResource DmRadiusTight}"
                Clicked="OnDeleteClicked"
                SemanticProperties.Description="Delete area"
                SemanticProperties.Hint="Asks for confirmation, then removes this area from its floor."
                ToolTipProperties.Text="Delete area">
                <Button.Behaviors>
                    <behaviors:HandCursorBehavior />
                </Button.Behaviors>
            </Button>

        </Grid>

        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnItemTapped" />
        </Border.GestureRecognizers>

        <!-- MASTER-175. The row body carries a TapGestureRecognizer above, so it is a clickable
             surface, and it is the largest one in an expanded floor — but it had no
             HandCursorBehavior at all while the two Buttons inside it did, so the pointer went
             from hand to arrow to hand as it crossed the row. This is ABSENCE being closed, not
             the inertness MASTER-165 alleges: measurement.md section 2 observed the hand cursor
             working on all three floor-card configurations, including the as-shipped one, so the
             behavior itself is sound. The attachment matches FloorSidebarItem.xaml:88, the same
             fix on the floor card body. It is a behavior and nothing else — no size, no padding,
             no margin, no gesture and no visual state changes here. -->
        <Border.Behaviors>
            <behaviors:HoverOrLongPressBehavior
                HoverEntered="OnHoverEntered"
                HoverExited="OnHoverExited" />
            <behaviors:HandCursorBehavior />
        </Border.Behaviors>
    </Border>
</ContentView>
