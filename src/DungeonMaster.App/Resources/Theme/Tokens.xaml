<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        SINGLE-LAYER DECISION — read this before adding tokens (Tasks 4-11).

        This file was planned as two dictionaries: Palette.xaml holding raw named
        colours, and Tokens.xaml aliasing them under semantic names by putting a
        StaticResource reference in the element content of a Color entry.

        That form does not compile. A markup extension in element-content position
        is handed to ColorTypeConverter as a literal string, and the MAUI XAML
        source generator rejects it with one error per aliased entry:

            Resources/Theme/Tokens.xaml(1,2): error MAUIG1010:
            Cannot convert "... DmPaletteInk900" into "Microsoft.Maui.Graphics.Color".

        Verified by spike on 2026-08-05 against net10.0-windows10.0.19041.0.
        A StaticResource reference still works in ATTRIBUTE position, which is why
        the SolidColorBrush entries below alias their colours successfully.

        So the palette layer is merged into this file. This is now the ONLY file
        in the application permitted to contain colour literals; ThemeDictionaryTests
        enforces that. Add new colours here as semantic names, never as a raw hex
        at a usage site.

        ─────────────────────────────────────────────────────────────────────────
        COLOURS SHARED ACROSS TOKENS — CHANGE THESE TOGETHER

        The abandoned two-layer design encoded this structurally: each of these
        tokens was a reference to one palette entry, so a restyle edited one line.
        In a single layer they are textually identical lines that must still move
        together, and only this list says so. If you change one, change all of its
        siblings — or deliberately split them and delete the row.

          #C8A040   DmAccentGoldLight
                    DmDragPlaceholderStroke
                    DmAreaSelectedBorder
                    DmMapArea
                    DmMapObjectPlaceholder
          #F5E4B0   DmTextTavern
                    DmMapVertex
          #664a3820 DmScrollbarThumb
                    DmTextSelection

        Keep this list correct when adding tokens: a literal that appears at two
        keys and is not listed here is a latent restyle bug.
        ─────────────────────────────────────────────────────────────────────────
    -->

    <!-- ═══════════════════════════════════════════════════════════════
         Structural: Dark Tavern surface family
    ═══════════════════════════════════════════════════════════════ -->
    <Color x:Key="DmSurfaceTavern">#1A1208</Color>
    <Color x:Key="DmSurfaceTavernRaised">#2E8B5E1A</Color>
    <Color x:Key="DmSurfaceTavernRaisedHover">#528B5E1A</Color>
    <Color x:Key="DmSurfaceTavernRaisedActive">#6A8B5E1A</Color>
    <Color x:Key="DmBorderTavern">#4DC4862A</Color>
    <Color x:Key="DmBorderTavernHover">#A6C4862A</Color>
    <Color x:Key="DmTextTavern">#F5E4B0</Color>
    <Color x:Key="DmTextTavernMuted">#A08050</Color>

    <!-- ═══════════════════════════════════════════════════════════════
         Structural: Light Parchment surface family
    ═══════════════════════════════════════════════════════════════ -->
    <Color x:Key="DmSurfaceParchment">#F5E8C8</Color>
    <Color x:Key="DmSurfaceParchmentDeep">#ECD8A0</Color>
    <Color x:Key="DmBorderParchment">#8B5E1A</Color>
    <Color x:Key="DmTextParchment">#2C1A08</Color>
    <Color x:Key="DmTextParchmentMuted">#7A5030</Color>

    <!-- ═══════════════════════════════════════════════════════════════
         Accents
    ═══════════════════════════════════════════════════════════════ -->
    <Color x:Key="DmAccentGold">#C4862A</Color>
    <Color x:Key="DmAccentGoldLight">#C8A040</Color>
    <Color x:Key="DmAccentGoldDark">#B08828</Color>

    <!-- ═══════════════════════════════════════════════════════════════
         Action semantics
    ═══════════════════════════════════════════════════════════════ -->
    <Color x:Key="DmConfirm">#2D5C1A</Color>
    <Color x:Key="DmConfirmText">#D4EDB0</Color>
    <Color x:Key="DmDestructive">#8B2020</Color>
    <Color x:Key="DmDestructiveText">#F5D0D0</Color>
    <Color x:Key="DmNeutralSurface">#1F785014</Color>
    <Color x:Key="DmNeutralBorder">#5A3010</Color>
    <Color x:Key="DmSave">#4A8A30</Color>
    <Color x:Key="DmSaveText">#8ACA60</Color>
    <Color x:Key="DmDiscard">#A03030</Color>
    <Color x:Key="DmDiscardText">#E08080</Color>

    <!-- ═══════════════════════════════════════════════════════════════
         Feature-specific: notebook ribbons
    ═══════════════════════════════════════════════════════════════ -->
    <Color x:Key="DmRibbonRead">#A32B24</Color>
    <Color x:Key="DmRibbonReadDim">#6B2019</Color>
    <Color x:Key="DmRibbonText">#F0DCA8</Color>
    <Color x:Key="DmRibbonSeal">#E8B4B4</Color>

    <!-- ═══════════════════════════════════════════════════════════════
         Feature-specific: flag banner gradient
    ═══════════════════════════════════════════════════════════════ -->
    <Color x:Key="DmBannerEdge">#7A4F12</Color>
    <Color x:Key="DmBannerCenter">#B8781E</Color>

    <!-- ═══════════════════════════════════════════════════════════════
         Feature-specific: sidebar drag and drop
    ═══════════════════════════════════════════════════════════════ -->
    <Color x:Key="DmDragPlaceholderStroke">#C8A040</Color>
    <Color x:Key="DmDragPlaceholderFill">#20C8A040</Color>

    <!-- ═══════════════════════════════════════════════════════════════
         Feature-specific: map area selection and hover tints
    ═══════════════════════════════════════════════════════════════ -->
    <Color x:Key="DmAreaSelectedBorder">#C8A040</Color>
    <Color x:Key="DmAreaSelectedTint">#18C8A040</Color>
    <Color x:Key="DmGoldHoverTint">#10C8A040</Color>
    <Color x:Key="DmEditorGlowTint">#08C4862A</Color>

    <!-- ═══════════════════════════════════════════════════════════════
         Feature-specific: FloorMapDrawable
    ═══════════════════════════════════════════════════════════════ -->
    <Color x:Key="DmMapGrid">#1AC4862A</Color>
    <Color x:Key="DmMapArea">#C8A040</Color>
    <Color x:Key="DmMapVertex">#F5E4B0</Color>
    <Color x:Key="DmMapAreaFillActive">#40C8A040</Color>
    <Color x:Key="DmMapAreaStrokeActive">#90C8A040</Color>
    <!-- The stand-in for an object with no drawable image: the "?" fallback glyph and outline
         and the dashed ghost-placement outline. Deliberately not DmMapArea, which it currently
         matches — these are object-placeholder renderings, not area outlines. -->
    <Color x:Key="DmMapObjectPlaceholder">#C8A040</Color>

    <!-- ═══════════════════════════════════════════════════════════════
         Feature-specific: tool palette chrome (the parchment strip)

         ControlsPaletteView, ObjectPaletteView and SecondaryPaletteView, plus the
         WinUI ComboBox overrides in Platforms/Windows/App.xaml that have to match
         them. The palette's own custom scrollbar reuses the chip colours: thumb =
         DmSurfaceToolChip, thumb hover = DmSurfaceToolChipHover, thumb stroke =
         DmBorderToolChip.
    ═══════════════════════════════════════════════════════════════ -->
    <Color x:Key="DmSurfaceToolPanel">#EDD8A0</Color>
    <Color x:Key="DmSurfaceToolChip">#C8AC78</Color>
    <Color x:Key="DmSurfaceToolChipHover">#E8CC9A</Color>
    <Color x:Key="DmBorderToolChip">#9A7820</Color>
    <Color x:Key="DmTextToolPanel">#5C3E10</Color>

    <!-- ═══════════════════════════════════════════════════════════════
         Feature-specific: designer canvas chrome

         The object action popup (DungeonDetailPage.xaml), the zoom stepper
         triangles, the hairline dividers between button groups, and the notebook
         body text sitting on parchment.
    ═══════════════════════════════════════════════════════════════ -->
    <Color x:Key="DmSurfacePopup">#1A1610</Color>
    <Color x:Key="DmBorderPopup">#4a3a1a</Color>
    <Color x:Key="DmDivider">#3a2e1a</Color>
    <Color x:Key="DmSurfaceStepper">#3D2E12</Color>
    <Color x:Key="DmTextNotebook">#3A2410</Color>

    <!-- ═══════════════════════════════════════════════════════════════
         Feature-specific: WinUI scrollbar, text selection and combo items

         Platforms/Windows/App.xaml only. DmScrollbarThumb and DmTextSelection are
         the same literal for now — see the shared-colour list at the top.
    ═══════════════════════════════════════════════════════════════ -->
    <Color x:Key="DmScrollbarThumb">#664a3820</Color>
    <Color x:Key="DmScrollbarThumbDisabled">#332a2010</Color>
    <Color x:Key="DmTextSelection">#664a3820</Color>
    <Color x:Key="DmSurfaceComboItemHover">#D6BE82</Color>
    <Color x:Key="DmSurfaceComboItemPressed">#B89A60</Color>
    <Color x:Key="DmTextComboItemDisabled">#9A8060</Color>

    <!-- ═══════════════════════════════════════════════════════════════
         Feature-specific: object action popup buttons

         DungeonDetailPage.xaml.cs PopupBtn* states. DmDestructiveBright is the
         delete glyph: a lighter red than DmDestructive (#8B2020) because it sits
         on the near-black popup surface rather than on parchment.
    ═══════════════════════════════════════════════════════════════ -->
    <Color x:Key="DmDestructiveBright">#CC3030</Color>
    <Color x:Key="DmPopupButtonHover">#33C8A040</Color>
    <Color x:Key="DmPopupButtonPressed">#66C8A040</Color>
    <Color x:Key="DmPopupButtonDestructiveHover">#33CC3030</Color>
    <Color x:Key="DmPopupButtonDestructivePressed">#66CC3030</Color>

    <!-- ═══════════════════════════════════════════════════════════════
         Feature-specific: hairlines, placeholders and notebook state

         DmHairline is the common 1px separator (NotebookView footer,
         FloorSidebarItem area list). DmHairlineStrong is the heavier rule under
         the notebook header. DmSavedStamp is deliberately not DmConfirm: the
         source note at NotebookView.xaml.cs:101 says "committed" must read as
         reassuring rather than as an action to take.
    ═══════════════════════════════════════════════════════════════ -->
    <Color x:Key="DmHairline">#478B5E1A</Color>
    <Color x:Key="DmHairlineStrong">#6B8B5E1A</Color>
    <Color x:Key="DmTextPlaceholder">#8C7A5030</Color>
    <Color x:Key="DmDestructiveHoverSurface">#248B2020</Color>
    <Color x:Key="DmSavedStamp">#4A6A2A</Color>

    <!-- ═══════════════════════════════════════════════════════════════
         NEAR-DUPLICATE COLOURS — DO NOT COLLAPSE

         Each pair differs by one in a single channel. Merging either is a restyle
         decision, not a refactor one; this theme is behaviour-preserving for
         colour. Proposed for merge in the Task 3 audit table.

           DmSurfaceParchmentDeep      #ECD8A0    vs  DmSurfaceToolPanel  #EDD8A0
           DmSurfaceTavernRaisedActive #6A8B5E1A  vs  DmHairlineStrong    #6B8B5E1A
    ═══════════════════════════════════════════════════════════════ -->

    <!-- ═══════════════════════════════════════════════════════════════
         Brushes. {StaticResource} works here because it sits in attribute
         position rather than element content — see the note at the top.
    ═══════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="DmAccentGoldBrush" Color="{StaticResource DmAccentGold}" />
    <SolidColorBrush x:Key="DmBorderTavernBrush" Color="{StaticResource DmBorderTavern}" />
    <SolidColorBrush x:Key="DmBorderTavernHoverBrush" Color="{StaticResource DmBorderTavernHover}" />
    <SolidColorBrush x:Key="DmBorderParchmentBrush" Color="{StaticResource DmBorderParchment}" />

    <!-- ═══════════════════════════════════════════════════════════════
         Geometry
    ═══════════════════════════════════════════════════════════════ -->
    <x:Double x:Key="DmRadiusTight">2</x:Double>
    <x:Double x:Key="DmRadiusDefault">3</x:Double>
    <x:Double x:Key="DmRadiusLoose">4</x:Double>
    <x:Double x:Key="DmStrokeHairline">1</x:Double>
    <x:Double x:Key="DmStrokeEmphasis">2</x:Double>

    <!-- Shared height of the map toolbar and the sidebar dungeon card, so their bottom
         edges line up across the two columns of the designer.

         54.4 is NOT arithmetic — it is the toolbar's rendered height, read back from the
         live layout on Windows at the current type scale (tool icons, tool letter labels
         and the right-hand Undo group), and confirmed constant from a 357 DIU wide
         toolbar up to 1157 DIU, so the row never reflows. WinUI's line height for these
         fonts cannot be derived from the markup; an earlier attempt to compute it from
         padding, stroke and an assumed font-size multiplier was visibly wrong on screen.

         If any font size, padding or stroke inside the toolbar changes, this number must
         be RE-MEASURED from a rendered frame, not recalculated. Too small clips the tool
         tiles; too large leaves a gap under them. -->
    <x:Double x:Key="DmToolbarHeight">54.4</x:Double>

</ResourceDictionary>
