<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:controls="clr-namespace:DungeonMaster.App.Controls"
    xmlns:behaviors="clr-namespace:DungeonMaster.App.Behaviors"
    xmlns:vm="clr-namespace:DungeonMaster.App.ViewModels"
    x:Class="DungeonMaster.App.Views.CreateDungeonPopup"
    x:TypeArguments="x:Boolean"
    BackgroundColor="Transparent"
    Margin="0"
    Padding="0"
    CanBeDismissedByTappingOutsideOfPopup="False">

    <controls:DmPopup x:Name="Chrome" Title="New Dungeon">
        <controls:DmPopup.Body>
            <VerticalStackLayout Spacing="14">

                <!-- Error -->
                <Label
                    Text="{Binding ErrorMessage}"
                    FontFamily="{StaticResource DmFontBody}"
                    FontSize="{StaticResource DmFontSizeBodySmall}"
                    TextColor="{StaticResource DmDestructive}"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource NotNullConverter}}" />

                <!-- Name field -->
                <VerticalStackLayout Spacing="4">
                    <Label
                        Text="NAME *"
                        FontFamily="{StaticResource DmFontTitle}"
                        FontSize="{StaticResource DmFontSizeAction}"
                        CharacterSpacing="1.5"
                        TextColor="{StaticResource DmTextParchmentMuted}" />
                    <Border
                        Style="{StaticResource DmBorderParchmentStyle}"
                        Padding="10,4">
                        <Entry
                            Style="{StaticResource DmEntryParchment}"
                            Text="{Binding Name, Mode=TwoWay}"
                            Placeholder="Enter dungeon name" />
                    </Border>
                </VerticalStackLayout>

                <!-- Description field -->
                <VerticalStackLayout Spacing="4">
                    <Label
                        Text="DESCRIPTION"
                        FontFamily="{StaticResource DmFontTitle}"
                        FontSize="{StaticResource DmFontSizeAction}"
                        CharacterSpacing="1.5"
                        TextColor="{StaticResource DmTextParchmentMuted}" />
                    <Border
                        Style="{StaticResource DmBorderParchmentStyle}"
                        Padding="10,4">
                        <Editor
                            Style="{StaticResource DmEditorParchment}"
                            Text="{Binding Description, Mode=TwoWay}"
                            FontFamily="{StaticResource DmFontBodyItalic}"
                            Placeholder="Optional — a sentence about this place"
                            HeightRequest="72" />
                    </Border>
                </VerticalStackLayout>

                <!-- Buttons -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button
                        Grid.Column="0"
                        Text="CANCEL"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource DmNeutralButton}"
                        CharacterSpacing="1"
                        BorderWidth="1.5">
                        <Button.Behaviors>
                            <behaviors:HandCursorBehavior />
                        </Button.Behaviors>
                    </Button>
                    <Button
                        Grid.Column="1"
                        Text="CREATE"
                        Style="{StaticResource DmConfirmButton}"
                        Command="{Binding CreateCommand}"
                        CharacterSpacing="1">
                        <Button.Behaviors>
                            <behaviors:HandCursorBehavior />
                        </Button.Behaviors>
                    </Button>
                </Grid>

            </VerticalStackLayout>
        </controls:DmPopup.Body>
    </controls:DmPopup>

</toolkit:Popup>
