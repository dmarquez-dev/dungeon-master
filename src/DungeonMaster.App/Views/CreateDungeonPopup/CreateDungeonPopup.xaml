<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:controls="clr-namespace:DungeonMaster.App.Controls"
    xmlns:behaviors="clr-namespace:DungeonMaster.App.Behaviors"
    xmlns:vm="clr-namespace:DungeonMaster.App.ViewModels"
    x:Class="DungeonMaster.App.Views.CreateDungeonPopup"
    x:TypeArguments="x:Boolean"
    BackgroundColor="Transparent"
    Margin="0"
    Padding="0"
    CanBeDismissedByTappingOutsideOfPopup="False"
    x:DataType="vm:CreateDungeonViewModel">

    <!-- THE ROOT x:DataType IS ON, AND EXACTLY ONE BINDING OPTS OUT OF IT. This was tried, not
         assumed, and retried on 2026-08-27 (MASTER-083 / UI-030). Adding
         x:DataType="vm:CreateDungeonViewModel" here to compile the view-model bindings FAILED
         the build under TreatWarningsAsErrors, with MAUIG2045 on two distinct causes. ONE OF
         THE TWO IS FIXED; the other is opted out per-binding, below.

           - FIXED. "Property 'ButtonRowSpacing' not found on
             'global::DungeonMaster.App.ViewModels.CreateDungeonViewModel'" for the button row
             below, whose Binding sets Source={x:Reference Chrome} and so does not target the
             root DataType at all. Two changes together address it: the project property
             MauiEnableXamlCBindingWithSourceCompilation (DungeonMaster.App.csproj), which makes
             the generator compile a Source-bearing binding against its Source; and the
             binding-level x:DataType=controls:DmPopup on that binding, which names the type the
             Source is. That binding IS compiled today.

           - STILL UNCOMPILED, AND OPTED OUT EXPLICITLY. With the root x:DataType in place and
             no opt-out, the build reports, verbatim (re-observed 2026-09-01):

               error MAUIG2045: Binding: Property "CreateCommand" not found on
               "global::DungeonMaster.App.ViewModels.CreateDungeonViewModel". The binding will
               use slower reflection-based binding at runtime. If this property is generated by
               another source generator, consider reporting this at
               https://github.com/dotnet/maui/issues to help us improve source generator
               interoperability.

             CreateCommand is emitted by CommunityToolkit.Mvvm's [RelayCommand] generator and
             MAUI's binding generator cannot see another generator's output — the diagnostic
             says so itself. Note that CancelCommand, from the same generator, is NOT reported;
             the interop is partial, not absent. This markup CAN close the gap, with a
             per-binding opt-out: x:DataType={x:Null} written as an argument INSIDE the
             {Binding ...} markup extension, comma-separated after the path, excludes that one
             binding from the ambient root DataType and leaves it reflection-based:

               Command="{Binding CreateCommand, x:DataType={x:Null}}"

             The same technique is used at Views/DungeonDetailPage/DungeonDetailPage.xaml:58.

         CreateCommand is the ONLY binding here that needs the opt-out; the compiler names it and
         nothing else. Do not add a speculative one — every unnecessary opt-out silently
         un-compiles a binding that was working. Measured 2026-09-01: 7 bindings in this file,
         6 compiled, 1 opted out. No revisit is needed; if MAUI's generator later handles
         cross-generator members the opt-out can simply go. The Source half is likewise done. -->
    <controls:DmPopup x:Name="Chrome" Title="New Dungeon">
        <controls:DmPopup.Body>
            <!-- No Spacing here: DmPopup.ContentSpacing supplies it, so every popup
                 body shares one value. Setting it locally would opt out. -->
            <VerticalStackLayout>

                <!-- Error -->
                <Label
                    Text="{Binding ErrorMessage}"
                    FontFamily="{StaticResource DmFontBody}"
                    FontSize="{StaticResource DmFontSizeBodySmall}"
                    TextColor="{StaticResource DmDestructive}"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource NotNullConverter}}" />

                <!-- Name field -->
                <VerticalStackLayout Spacing="{StaticResource DmSpaceXS}">
                    <Label
                        Text="NAME *"
                        FontFamily="{StaticResource DmFontTitle}"
                        FontSize="{StaticResource DmFontSizeAction}"
                        CharacterSpacing="1.5"
                        TextColor="{StaticResource DmTextParchmentMuted}" />
                    <Border
                        Style="{StaticResource DmBorderParchmentStyle}"
                        Padding="{StaticResource DmPaddingControl}">
                        <Entry
                            Style="{StaticResource DmEntryParchment}"
                            Text="{Binding Name, Mode=TwoWay}"
                            Placeholder="Enter dungeon name" />
                    </Border>
                </VerticalStackLayout>

                <!-- Description field -->
                <VerticalStackLayout Spacing="{StaticResource DmSpaceXS}">
                    <Label
                        Text="DESCRIPTION"
                        FontFamily="{StaticResource DmFontTitle}"
                        FontSize="{StaticResource DmFontSizeAction}"
                        CharacterSpacing="1.5"
                        TextColor="{StaticResource DmTextParchmentMuted}" />
                    <Border
                        Style="{StaticResource DmBorderParchmentStyle}"
                        Padding="{StaticResource DmPaddingControl}">
                        <Editor
                            Style="{StaticResource DmEditorParchment}"
                            Text="{Binding Description, Mode=TwoWay}"
                            FontFamily="{StaticResource DmFontBodyItalic}"
                            Placeholder="Optional — a sentence about this place"
                            HeightRequest="72" />
                    </Border>
                </VerticalStackLayout>

                <!-- Buttons -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="{Binding ButtonRowSpacing, Source={x:Reference Chrome}, x:DataType=controls:DmPopup}">
                    <Button
                        Grid.Column="0"
                        Text="CANCEL"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource DmNeutralButton}"
                        CharacterSpacing="1"
                        BorderWidth="{StaticResource DmStrokeMedium}">
                        <Button.Behaviors>
                            <behaviors:HandCursorBehavior />
                        </Button.Behaviors>
                    </Button>
                    <Button
                        Grid.Column="1"
                        Text="CREATE"
                        Style="{StaticResource DmConfirmButton}"
                        Command="{Binding CreateCommand, x:DataType={x:Null}}"
                        CharacterSpacing="1">
                        <Button.Behaviors>
                            <behaviors:HandCursorBehavior />
                        </Button.Behaviors>
                    </Button>
                </Grid>

            </VerticalStackLayout>
        </controls:DmPopup.Body>
    </controls:DmPopup>

</toolkit:Popup>
