<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DungeonMaster.App.Controls"
    xmlns:behaviors="clr-namespace:DungeonMaster.App.Behaviors"
    xmlns:dto="clr-namespace:DungeonMaster.Application.Features.Dungeons.Queries.GetDungeons;assembly=DungeonMaster.Application"
    xmlns:vm="clr-namespace:DungeonMaster.App.ViewModels"
    x:Class="DungeonMaster.App.Views.DungeonListPage"
    x:DataType="vm:DungeonListViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource DmSurfaceTavern}">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*"
          Padding="{StaticResource DmPaddingPage}"
          RowSpacing="{StaticResource DmSpaceLarge}">

        <controls:DmFlagBanner Grid.Row="0" Title="Dungeons" />

        <Label
            Grid.Row="1"
            Text="{Binding ErrorMessage}"
            FontFamily="{StaticResource DmFontBody}"
            FontSize="{StaticResource DmFontSizeBody}"
            TextColor="{StaticResource DmDestructive}"
            IsVisible="{Binding ErrorMessage, Converter={StaticResource NotNullConverter}}" />

        <controls:DmSearchBar
            Grid.Row="2"
            SearchText="{Binding SearchText, Mode=TwoWay}" />

        <controls:DmDivider Grid.Row="3" />

        <Grid Grid.Row="4">
            <CollectionView
                ItemsSource="{Binding FilteredDungeons}"
                EmptyView="No dungeons found.">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="{StaticResource DmSpaceMedium}" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:DungeonSummaryDto">
                        <controls:DmCard
                            Title="{Binding Name}"
                            Subtitle="{Binding Description}">
                            <controls:DmCard.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCardTapped" />
                            </controls:DmCard.GestureRecognizers>
                            <controls:DmCard.TrailingContent>
                                <HorizontalStackLayout Spacing="{StaticResource DmSpaceXS}">

                                    <!-- Edit / Plan button -->
                                    <Button
                                        Text="&#xEA75;"
                                        FontFamily="{StaticResource DmFontIcon}"
                                        FontSize="{StaticResource DmIconSizeXL}"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource DmAccentGoldLight}"
                                        CornerRadius="{StaticResource DmRadiusDefault}"
                                        Padding="{StaticResource DmPaddingCompact}"
                                        CommandParameter="{Binding Id}"
                                        Clicked="OnEditClicked"
                                        AutomationId="EditDungeonButton"
                                        SemanticProperties.Description="Edit dungeon"
                                        SemanticProperties.Hint="Opens this dungeon in the floor and map designer"
                                        ToolTipProperties.Text="Edit dungeon">
                                        <Button.Behaviors>
                                            <behaviors:HandCursorBehavior />
                                        </Button.Behaviors>
                                    </Button>

                                    <!-- Start Session button.

                                         UNWIRED. This carries neither Clicked nor Command, here
                                         or anywhere in the repository, and clicking it was
                                         confirmed at runtime to do nothing and log nothing. The
                                         CommandParameter below binds to a Command that does not
                                         exist. Wiring it is a feature, not a fix.

                                         The Hint therefore says the session cannot be started
                                         yet rather than describing what starting one would do:
                                         a screen reader reads the Hint out as a promise, and the
                                         accessibility layer must not assert something the
                                         control cannot deliver. Restore a descriptive Hint at
                                         the same time as the handler, not before. -->
                                    <Grid>
                                        <Button
                                            Text="&#xE97D;"
                                            FontFamily="{StaticResource DmFontIcon}"
                                            FontSize="{StaticResource DmIconSizeXL}"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource DmConfirm}"
                                            CornerRadius="{StaticResource DmRadiusDefault}"
                                            Padding="{StaticResource DmPaddingCompact}"
                                            CommandParameter="{Binding Id}"
                                            AutomationId="StartSessionButton"
                                            SemanticProperties.Description="Start session"
                                            SemanticProperties.Hint="Sessions are not available yet; this button performs no action."
                                            ToolTipProperties.Text="Start session"
                                            IsEnabled="{Binding FloorCount, Converter={StaticResource GreaterThanZeroConverter}}">
                                            <Button.Behaviors>
                                                <behaviors:HandCursorBehavior />
                                            </Button.Behaviors>
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button"
                                                    Binding="{Binding FloorCount, Converter={StaticResource GreaterThanZeroConverter}}"
                                                    Value="False">
                                                    <Setter Property="Opacity" Value="0.35" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                        <!-- Transparent overlay carries tooltip when button is disabled -->
                                        <BoxView
                                            BackgroundColor="Transparent"
                                            IsVisible="{Binding FloorCount, Converter={StaticResource GreaterThanZeroConverter}, ConverterParameter=Invert}"
                                            ToolTipProperties.Text="Add at least one floor before starting a session"
                                            InputTransparent="False" />
                                    </Grid>

                                    <!-- Delete button -->
                                    <Button
                                        Text="&#xE9FC;"
                                        FontFamily="{StaticResource DmFontIcon}"
                                        FontSize="{StaticResource DmIconSizeXL}"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource DmDestructive}"
                                        CornerRadius="{StaticResource DmRadiusDefault}"
                                        Padding="{StaticResource DmPaddingCompact}"
                                        CommandParameter="{Binding Id}"
                                        Clicked="OnDeleteClicked"
                                        AutomationId="DeleteDungeonButton"
                                        SemanticProperties.Description="Delete dungeon"
                                        SemanticProperties.Hint="Asks for confirmation first"
                                        ToolTipProperties.Text="Delete dungeon">
                                        <Button.Behaviors>
                                            <behaviors:HandCursorBehavior />
                                        </Button.Behaviors>
                                    </Button>

                                </HorizontalStackLayout>
                            </controls:DmCard.TrailingContent>
                        </controls:DmCard>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- CornerRadius 26 below is the geometric half of this button's own 52px height —
                 what makes it a circle — and not a style token. -->
            <Button
                x:Name="FabButton"
                Text="+"
                AutomationId="CreateDungeonButton"
                SemanticProperties.Description="New dungeon"
                ToolTipProperties.Text="New dungeon"
                FontFamily="{StaticResource DmFontTitle}"
                FontSize="{StaticResource DmFontSizeBanner}"
                WidthRequest="52"
                HeightRequest="52"
                CornerRadius="26"
                Padding="0"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,4,4"
                BackgroundColor="{StaticResource DmAccentGold}"
                TextColor="{StaticResource DmSurfaceTavern}"
                Clicked="OnCreateClicked">
                <Button.GestureRecognizers>
                    <PointerGestureRecognizer
                        PointerEntered="OnFabPointerEntered"
                        PointerExited="OnFabPointerExited" />
                </Button.GestureRecognizers>
                <Button.Behaviors>
                    <behaviors:HandCursorBehavior />
                </Button.Behaviors>
            </Button>
        </Grid>

    </Grid>
</ContentPage>
