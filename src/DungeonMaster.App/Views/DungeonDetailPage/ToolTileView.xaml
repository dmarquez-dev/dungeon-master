<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DungeonMaster.App.Views.DungeonDetail.ToolTileView">

    <!-- One tool chip of the designer's map toolbar: a bordered icon-plus-shortcut-letter pair
         that lights up when its tool is the active one. Six copies of this markup used to sit
         inline in DungeonDetailPage.xaml at 33 lines each, and the page's code-behind coloured
         all eighteen of their parts by name; the IsActive property below is what replaced that.

         Both Labels are removed from the accessibility tree on purpose. The icon is a private-use
         codepoint and the letter is a keyboard hint, so neither is a usable announcement — the
         description lives on the tile itself, which is the thing a screen-reader user activates. -->
    <Border x:Name="Chrome"
            BackgroundColor="Transparent"
            Stroke="Transparent"
            StrokeThickness="{StaticResource DmStrokeHairline}"
            Padding="{StaticResource DmPaddingCompact}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="{StaticResource DmRadiusDefault}" />
        </Border.StrokeShape>
        <HorizontalStackLayout Spacing="{StaticResource DmSpaceXS}" VerticalOptions="Center">
            <Label x:Name="IconLabel"
                   FontFamily="{StaticResource DmFontIcon}"
                   FontSize="{StaticResource DmIconSizeLarge}"
                   TextColor="{StaticResource DmTextTavernMuted}"
                   VerticalOptions="Center"
                   AutomationProperties.IsInAccessibleTree="False" />
            <Label x:Name="ShortcutLabel"
                   FontFamily="{StaticResource DmFontBody}"
                   FontSize="{StaticResource DmFontSizeCaption}"
                   TextColor="{StaticResource DmTextTavernMuted}"
                   VerticalOptions="Center"
                   AutomationProperties.IsInAccessibleTree="False" />
        </HorizontalStackLayout>
    </Border>
</ContentView>
