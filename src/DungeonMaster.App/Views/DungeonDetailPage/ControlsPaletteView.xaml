<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DungeonMaster.App.Views.DungeonDetail.ControlsPaletteView"
             IsVisible="False">
    <ContentView.Resources>
        <Style x:Key="PaletteButtonStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource DmSurfaceToolChip}" />
            <Setter Property="Stroke" Value="{StaticResource DmBorderToolChip}" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource DmSurfaceToolChip}" />
                                <Setter Property="Stroke" Value="{StaticResource DmBorderToolChip}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource DmSurfaceToolChipHover}" />
                                <Setter Property="Stroke" Value="{StaticResource DmAccentGoldLight}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentView.Resources>
    <Border BackgroundColor="{StaticResource DmSurfaceToolPanel}"
            Stroke="{StaticResource DmBorderParchment}"
            StrokeThickness="{StaticResource DmStrokeHairline}"
            Padding="{StaticResource DmPaddingCompact}"
            WidthRequest="220"
            HorizontalOptions="Start">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="{StaticResource DmRadiusLoose}" />
        </Border.StrokeShape>
        <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="0">

            <!-- ROTATE group -->
            <VerticalStackLayout Spacing="{StaticResource DmSpaceXS}" HorizontalOptions="Center">
                <Label Text="ROTATE"
                       FontFamily="{StaticResource DmFontTitle}"
                       FontSize="{StaticResource DmFontSizeMicro}"
                       CharacterSpacing="1"
                       TextColor="{StaticResource DmTextParchmentMuted}"
                       TextTransform="Uppercase"
                       HorizontalOptions="Center" />
                <!-- SCHEDULED FOR DELETION — the four glyph labels below (both arrows, minus and
                     plus) carry a measured TranslationX/Y. It cancels the glyph's ink offset
                     inside the font's line box, which VerticalTextAlignment cannot reach — that
                     centres the line box, not the ink within it. Translation is a render transform
                     applied after Rotation in screen space, which is why the rotated arrows are
                     corrected on X, not Y. These numbers are font-specific: re-measure them from a
                     rendered frame if the body font changes, if the icon size token changes, or if
                     these glyphs are replaced by real icon-font codepoints.

                     This is not a permanent mechanism to be maintained: the whole construct — the
                     translations, the square Border and the Fill options that make placement
                     deterministic — is deleted by the Phosphor icon-font migration, which replaces
                     these text-font glyphs with real icon codepoints that centre by construction.
                     See docs/superpowers/specs/2026-08-07-designer-icon-font-evaluation.md. -->
                <HorizontalStackLayout Spacing="{StaticResource DmSpaceXS}">
                    <!-- Measured translation — see the note above. -->
                    <Border x:Name="BtnCCW"
                            Style="{StaticResource PaletteButtonStyle}"
                            WidthRequest="32" HeightRequest="32"
                            StrokeThickness="{StaticResource DmStrokeHairline}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{StaticResource DmRadiusTight}" />
                        </Border.StrokeShape>
                        <Label Text="↺"
                               FontFamily="{StaticResource DmFontBody}"
                               FontSize="{StaticResource DmIconSizeTool}"
                               Rotation="-90"
                               TextColor="{StaticResource DmTextToolPanel}"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"
                               TranslationX="-2.0"
                               InputTransparent="True" />
                    </Border>
                    <!-- Measured translation — see the note above. -->
                    <Border x:Name="BtnCW"
                            Style="{StaticResource PaletteButtonStyle}"
                            WidthRequest="32" HeightRequest="32"
                            StrokeThickness="{StaticResource DmStrokeHairline}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{StaticResource DmRadiusTight}" />
                        </Border.StrokeShape>
                        <Label Text="↻"
                               FontFamily="{StaticResource DmFontBody}"
                               FontSize="{StaticResource DmIconSizeTool}"
                               Rotation="90"
                               TextColor="{StaticResource DmTextToolPanel}"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"
                               TranslationX="2.0"
                               InputTransparent="True" />
                    </Border>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Divider -->
            <BoxView WidthRequest="1" HeightRequest="44"
                     Color="{StaticResource DmDivider}"
                     Margin="8,0"
                     VerticalOptions="Center" />

            <!-- SCALE group -->
            <VerticalStackLayout Spacing="{StaticResource DmSpaceXS}" HorizontalOptions="Center">
                <Label Text="SCALE"
                       FontFamily="{StaticResource DmFontTitle}"
                       FontSize="{StaticResource DmFontSizeMicro}"
                       CharacterSpacing="1"
                       TextColor="{StaticResource DmTextParchmentMuted}"
                       TextTransform="Uppercase"
                       HorizontalOptions="Center" />
                <HorizontalStackLayout Spacing="{StaticResource DmSpaceXS}" VerticalOptions="Center">
                    <!-- Measured translation — see the note in the ROTATE group above. -->
                    <Border x:Name="BtnScaleDown"
                            Style="{StaticResource PaletteButtonStyle}"
                            WidthRequest="32" HeightRequest="32"
                            StrokeThickness="{StaticResource DmStrokeHairline}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{StaticResource DmRadiusTight}" />
                        </Border.StrokeShape>
                        <Label Text="−"
                               FontFamily="{StaticResource DmFontBody}"
                               FontSize="{StaticResource DmIconSizeTool}"
                               TextColor="{StaticResource DmTextToolPanel}"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"
                               TranslationY="-2.4"
                               InputTransparent="True" />
                    </Border>
                    <Label x:Name="ScaleReadout"
                           Text="1.0×"
                           FontFamily="{StaticResource DmFontBody}"
                           FontSize="{StaticResource DmFontSizeMeta}"
                           FontAttributes="Bold"
                           TextColor="{StaticResource DmTextToolPanel}"
                           MinimumWidthRequest="44"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           HorizontalTextAlignment="Center" />
                    <!-- Measured translation — see the note in the ROTATE group above. -->
                    <Border x:Name="BtnScaleUp"
                            Style="{StaticResource PaletteButtonStyle}"
                            WidthRequest="32" HeightRequest="32"
                            StrokeThickness="{StaticResource DmStrokeHairline}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{StaticResource DmRadiusTight}" />
                        </Border.StrokeShape>
                        <Label Text="+"
                               FontFamily="{StaticResource DmFontBody}"
                               FontSize="{StaticResource DmIconSizeTool}"
                               TextColor="{StaticResource DmTextToolPanel}"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"
                               TranslationY="-2.8"
                               InputTransparent="True" />
                    </Border>
                </HorizontalStackLayout>
            </VerticalStackLayout>

        </HorizontalStackLayout>
    </Border>
</ContentView>
