<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DungeonMaster.App.Views.DungeonDetail.ControlsPaletteView"
             IsVisible="False">
    <ContentView.Resources>
        <Style x:Key="PaletteButtonStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#C8AC78" />
            <Setter Property="Stroke" Value="#9A7820" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#C8AC78" />
                                <Setter Property="Stroke" Value="#9A7820" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#E8CC9A" />
                                <Setter Property="Stroke" Value="#C8A040" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentView.Resources>
    <Border BackgroundColor="#EDD8A0"
            Stroke="#8B5E1A"
            StrokeThickness="1"
            Padding="6,5,6,6"
            WidthRequest="216"
            HorizontalOptions="Start">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="4" />
        </Border.StrokeShape>
        <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="0">

            <!-- ROTATE group -->
            <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                <Label Text="ROTATE"
                       FontSize="9"
                       CharacterSpacing="1"
                       TextColor="#7A5030"
                       TextTransform="Uppercase"
                       HorizontalOptions="Center" />
                <HorizontalStackLayout Spacing="4">
                    <Border x:Name="BtnCCW"
                            Style="{StaticResource PaletteButtonStyle}"
                            WidthRequest="32" HeightRequest="32"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 2">
                        <Label Text="↺"
                               FontSize="22"
                               Rotation="-90"
                               TextColor="#5C3E10"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               InputTransparent="True" />
                    </Border>
                    <Border x:Name="BtnCW"
                            Style="{StaticResource PaletteButtonStyle}"
                            WidthRequest="32" HeightRequest="32"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 2">
                        <Label Text="↻"
                               FontSize="22"
                               Rotation="90"
                               TextColor="#5C3E10"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               InputTransparent="True" />
                    </Border>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Divider -->
            <BoxView WidthRequest="1" HeightRequest="44"
                     Color="#3a2e1a"
                     Margin="8,0"
                     VerticalOptions="Center" />

            <!-- SCALE group -->
            <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                <Label Text="SCALE"
                       FontSize="9"
                       CharacterSpacing="1"
                       TextColor="#7A5030"
                       TextTransform="Uppercase"
                       HorizontalOptions="Center" />
                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                    <Border x:Name="BtnScaleDown"
                            Style="{StaticResource PaletteButtonStyle}"
                            WidthRequest="32" HeightRequest="32"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 2">
                        <Label Text="−"
                               FontSize="22"
                               TextColor="#5C3E10"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               InputTransparent="True" />
                    </Border>
                    <Label x:Name="ScaleReadout"
                           Text="1.0×"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#5C3E10"
                           MinimumWidthRequest="44"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           HorizontalTextAlignment="Center" />
                    <Border x:Name="BtnScaleUp"
                            Style="{StaticResource PaletteButtonStyle}"
                            WidthRequest="32" HeightRequest="32"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 2">
                        <Label Text="+"
                               FontSize="22"
                               TextColor="#5C3E10"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               InputTransparent="True" />
                    </Border>
                </HorizontalStackLayout>
            </VerticalStackLayout>

        </HorizontalStackLayout>
    </Border>
</ContentView>
