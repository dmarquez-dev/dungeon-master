<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:DungeonMaster.App.Behaviors"
             x:Class="DungeonMaster.App.Views.DungeonDetail.ObjectPaletteView"
             IsVisible="False">

    <Border BackgroundColor="#EDD8A0"
            Stroke="#8B5E1A"
            StrokeThickness="1"
            Padding="6,4,6,6"
            WidthRequest="216"
            HorizontalOptions="Start">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="4" />
        </Border.StrokeShape>
        <VerticalStackLayout Spacing="4" MinimumWidthRequest="204">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Objects"
                       FontFamily="CinzelDecorative"
                       FontSize="17"
                       TextColor="#5C3E10"
                       TextTransform="Uppercase"
                       CharacterSpacing="1"
                       VerticalOptions="Center" />
                <Button x:Name="CloseButton"
                        Grid.Column="1"
                        Text="✕"
                        FontSize="12"
                        TextColor="#7A5030"
                        BackgroundColor="Transparent"
                        Padding="0"
                        WidthRequest="22" HeightRequest="22"
                        Clicked="OnClosePalette" />
            </Grid>

            <!-- Pack picker — styled via WinUI handler in code-behind -->
            <Picker x:Name="PackPicker"
                    FontFamily="EBGaramondRegular"
                    FontSize="15"
                    TextColor="#5C3E10"
                    BackgroundColor="#C8AC78"
                    HorizontalOptions="Fill"
                    SelectedIndexChanged="OnPackPickerChanged" />

            <!-- Category rows populated in code-behind -->
            <ScrollView x:Name="CategoryScrollView" HeightRequest="280" VerticalScrollBarVisibility="Always">
                <VerticalStackLayout x:Name="CategoriesContainer" Spacing="7" />
            </ScrollView>


        </VerticalStackLayout>
    </Border>
</ContentView>
