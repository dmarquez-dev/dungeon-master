<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:DungeonMaster.App.Behaviors"
             x:Class="DungeonMaster.App.Views.DungeonDetail.ObjectPaletteView"
             IsVisible="False">

    <Border BackgroundColor="{StaticResource DmSurfaceToolPanel}"
            Stroke="{StaticResource DmBorderParchment}"
            StrokeThickness="{StaticResource DmStrokeHairline}"
            Padding="{StaticResource DmPaddingCompact}"
            WidthRequest="220"
            HorizontalOptions="Start">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="{StaticResource DmRadiusLoose}" />
        </Border.StrokeShape>
        <VerticalStackLayout Spacing="{StaticResource DmSpaceXS}" MinimumWidthRequest="204">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Objects"
                       FontFamily="{StaticResource DmFontTitleDecorative}"
                       FontSize="{StaticResource DmFontSizeHeading}"
                       TextColor="{StaticResource DmTextToolPanel}"
                       TextTransform="Uppercase"
                       CharacterSpacing="1"
                       VerticalOptions="Center" />
                <Button x:Name="CloseButton"
                        Grid.Column="1"
                        Text="✕"
                        AutomationId="ObjectPaletteCloseButton"
                        SemanticProperties.Description="Close the object palette"
                        ToolTipProperties.Text="Close"
                        FontFamily="{StaticResource DmFontIcon}"
                        FontSize="{StaticResource DmIconSizeTiny}"
                        TextColor="{StaticResource DmTextParchmentMuted}"
                        BackgroundColor="Transparent"
                        Padding="0"
                        WidthRequest="22" HeightRequest="22"
                        Clicked="OnClosePalette" />
            </Grid>

            <!-- Pack picker — styled via WinUI handler in code-behind -->
            <Picker x:Name="PackPicker"
                    FontFamily="{StaticResource DmFontBody}"
                    FontSize="{StaticResource DmFontSizeBodySmall}"
                    TextColor="{StaticResource DmTextToolPanel}"
                    BackgroundColor="{StaticResource DmSurfaceToolChip}"
                    HorizontalOptions="Fill"
                    SelectedIndexChanged="OnPackPickerChanged" />

            <!-- Category rows populated in code-behind -->
            <ScrollView x:Name="CategoryScrollView" HeightRequest="280" VerticalScrollBarVisibility="Always">
                <VerticalStackLayout x:Name="CategoriesContainer" Spacing="{StaticResource DmSpaceMedium}" />
            </ScrollView>

        </VerticalStackLayout>
    </Border>
</ContentView>
