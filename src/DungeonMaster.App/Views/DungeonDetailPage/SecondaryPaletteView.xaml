<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DungeonMaster.App.Views.DungeonDetail.SecondaryPaletteView">

    <Border BackgroundColor="{StaticResource DmSurfaceToolPanel}"
            Stroke="{StaticResource DmBorderParchment}"
            StrokeThickness="{StaticResource DmStrokeHairline}"
            Padding="8"
            WidthRequest="272"
            HorizontalOptions="Start">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="4" />
        </Border.StrokeShape>
        <VerticalStackLayout Spacing="4">

            <Grid ColumnDefinitions="*,Auto">
                <Label x:Name="TitleLabel"
                       Grid.Column="0"
                       FontFamily="{StaticResource DmFontBody}"
                       FontSize="{StaticResource DmFontSizeCaption}"
                       TextColor="{StaticResource DmTextToolPanel}"
                       TextTransform="Uppercase"
                       CharacterSpacing="0.8"
                       VerticalOptions="Center" />
                <Button x:Name="CloseButton"
                        Grid.Column="1"
                        Text="✕"
                        FontFamily="{StaticResource DmFontIcon}"
                        FontSize="{StaticResource DmIconSizeTiny}"
                        TextColor="{StaticResource DmTextParchmentMuted}"
                        BackgroundColor="Transparent"
                        Padding="0"
                        WidthRequest="22" HeightRequest="22"
                        Clicked="OnCloseClicked" />
            </Grid>

            <ScrollView x:Name="ScrollArea"
                        Orientation="Vertical"
                        VerticalScrollBarVisibility="Always"
                        MaximumHeightRequest="200">
                <Grid x:Name="ObjectGrid"
                      ColumnSpacing="4"
                      RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </ScrollView>

        </VerticalStackLayout>
    </Border>
</ContentView>
