<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DungeonMaster.App.Controls"
    xmlns:behaviors="clr-namespace:DungeonMaster.App.Behaviors"
    xmlns:vm="clr-namespace:DungeonMaster.App.ViewModels"
    xmlns:palette="clr-namespace:DungeonMaster.App.Views.DungeonDetail"
    x:Class="DungeonMaster.App.Views.DungeonDetailPage"
    x:DataType="vm:DungeonDetailViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource DMBackground}">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="0" Padding="16,12,16,0">

        <!-- Row 0: Top nav bar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
            <Button
                Grid.Column="0"
                Text="&#x2190; Back"
                FontFamily="EBGaramondRegular"
                FontSize="20"
                BackgroundColor="Transparent"
                TextColor="{StaticResource DMScrollGoldLight}"
                Padding="0,4"
                Clicked="OnBackClicked">
                <Button.Behaviors>
                    <behaviors:HandCursorBehavior />
                </Button.Behaviors>
            </Button>

            <HorizontalStackLayout
                Grid.Column="1"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="6">
                <Label
                    Text="&#xEA75;"
                    FontFamily="RpgAwesome"
                    FontSize="14"
                    TextColor="{StaticResource DMTextMuted}"
                    VerticalOptions="Center" />
                <Label
                    Text="DUNGEON EDITOR"
                    FontFamily="CinzelRegular"
                    FontSize="12"
                    CharacterSpacing="1.5"
                    TextColor="{StaticResource DMTextMuted}"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Grid Grid.Column="2">
                <Button
                    Text="Start Session"
                    FontFamily="EBGaramondRegular"
                    FontSize="20"
                    BackgroundColor="{StaticResource DMConfirm}"
                    TextColor="{StaticResource DMConfirmText}"
                    CornerRadius="3"
                    Padding="36,6,12,6"
                    IsEnabled="{Binding Dungeon.FloorCount, Converter={StaticResource GreaterThanZeroConverter}}">
                    <Button.Behaviors>
                        <behaviors:HandCursorBehavior />
                    </Button.Behaviors>
                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                            Binding="{Binding Dungeon.FloorCount, Converter={StaticResource GreaterThanZeroConverter}}"
                            Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <!-- Crossed-sword icon overlaid on the left of the button -->
                <Label Text="&#xE97D;"
                       FontFamily="RpgAwesome"
                       FontSize="16"
                       TextColor="{StaticResource DMConfirmText}"
                       HorizontalOptions="Start"
                       VerticalOptions="Center"
                       Margin="12,0,0,0"
                       InputTransparent="True" />
                <!-- Transparent overlay carries tooltip when button is disabled -->
                <BoxView
                    BackgroundColor="Transparent"
                    IsVisible="{Binding Dungeon.FloorCount, Converter={StaticResource GreaterThanZeroConverter}, ConverterParameter=Invert}"
                    ToolTipProperties.Text="Add at least one floor before starting a session"
                    InputTransparent="False" />
            </Grid>
        </Grid>

        <!-- Row 1: Full-width DmFlagBanner + centered bookmark tab -->
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto">
            <controls:DmFlagBanner
                x:Name="TitleBanner"
                Grid.Row="0"
                IsEditable="True"
                Title="{Binding Dungeon.Name}"
                TextCommitted="OnDungeonNameCommitted" />

            <Border
                x:Name="LoreBookmarkTab"
                Grid.Row="1"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                Margin="0,-8,0,0"
                Stroke="{StaticResource DMScrollGoldLight}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 0,0,8,8"
                Padding="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#3A2510" Offset="0.0" />
                        <GradientStop Color="#1A0C05" Offset="0.25" />
                        <GradientStop Color="#080402" Offset="0.5" />
                        <GradientStop Color="#1A0C05" Offset="0.75" />
                        <GradientStop Color="#3A2510" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLoreBookmarkTapped" />
                </Border.GestureRecognizers>
                <Border.Behaviors>
                    <behaviors:HandCursorBehavior />
                </Border.Behaviors>
                <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8" Padding="16,5,16,8">
                    <Label
                        Grid.Column="0"
                        Text="&#xEA8F;"
                        FontFamily="RpgAwesome"
                        FontSize="10"
                        TextColor="{StaticResource DMScrollGoldLight}"
                        VerticalOptions="Center" />
                    <Label
                        x:Name="LoreBookmarkLabel"
                        Grid.Column="1"
                        Text="LORE &amp; NOTES  &#x25BE;"
                        FontFamily="CinzelRegular"
                        FontSize="13"
                        CharacterSpacing="1.2"
                        TextColor="{StaticResource DMScrollGoldLight}"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Column="2"
                        Text="&#xEA8F;"
                        FontFamily="RpgAwesome"
                        FontSize="10"
                        TextColor="{StaticResource DMScrollGoldLight}"
                        VerticalOptions="Center"
                        ScaleX="-1" />
                </Grid>
            </Border>
        </Grid>

        <!-- Row 2: Lore drawer (collapsed by default) -->
        <Grid
            x:Name="LoreDrawer"
            Grid.Row="2"
            IsVisible="False">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnLoreDrawerTapped" />
            </Grid.GestureRecognizers>
            <VerticalStackLayout Spacing="6" Padding="0,8,0,0">
                <!-- Description -->
                <controls:DmInlineEditor
                    x:Name="DescriptionEditor"
                    Opacity="0.65"
                    FontFamily="EBGaramondItalic"
                    FontSize="20"
                    Placeholder="Add a description..."
                    TextCommitted="OnDescriptionCommitted" />

                <!-- Notes -->
                <controls:DmInlineEditor
                    x:Name="NotesEditor"
                    FontFamily="EBGaramondRegular"
                    FontSize="17"
                    Placeholder="DM notes..."
                    TextCommitted="OnNotesCommitted" />
            </VerticalStackLayout>
        </Grid>

        <!-- Row 3: Decorative divider between lore section and map -->
        <controls:DmDivider
            Grid.Row="3"
            Margin="0,6,0,4" />

        <!-- Row 4: Map canvas (left) | Floors sidebar (right) -->
        <Grid Grid.Row="4" ColumnDefinitions="*,300" ColumnSpacing="16">

            <!-- LEFT COLUMN: toolbar (edit mode only) + map canvas -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*">

                <!-- Map toolbar (hidden until a floor is selected) -->
                <Border x:Name="MapToolbar" Grid.Row="0" IsVisible="False"
                        BackgroundColor="{StaticResource DMCardSurface}"
                        Stroke="{StaticResource DMCardBorderBrush}"
                        StrokeShape="RoundRectangle 3"
                        StrokeThickness="1"
                        Padding="6,4"
                        Margin="0,0,0,4">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">

                        <!-- Left: context-switching area -->
                        <Grid Grid.Column="0">

                            <!-- Floor context: name input + drawing tools -->
                            <Grid x:Name="FloorContextToolbar" IsVisible="True"
                                  ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="4">

                                <controls:DmInlineEditor
                                    x:Name="FloorNameToolbarEditor"
                                    Grid.Column="0"
                                    FontFamily="CinzelSemiBold"
                                    FontSize="15"
                                    AcceptsReturn="False"
                                    Placeholder="Floor name..."
                                    TextCommitted="OnFloorNameToolbarCommitted"
                                    VerticalOptions="Center" />

                                <!-- Draw tool — active by default -->
                                <Border
                                    x:Name="ToolDrawBorder"
                                    Grid.Column="1"
                                    BackgroundColor="Transparent"
                                    Stroke="{StaticResource DMScrollGoldLight}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 3"
                                    Padding="8,4"
                                    ToolTipProperties.Text="Draw area (D)">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnToolDrawClicked" />
                                    </Border.GestureRecognizers>
                                    <Border.Behaviors>
                                        <behaviors:HandCursorBehavior />
                                    </Border.Behaviors>
                                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                        <Label
                                            x:Name="ToolDrawIcon"
                                            Text="&#xEA75;"
                                            FontFamily="RpgAwesome"
                                            FontSize="17"
                                            TextColor="{StaticResource DMScrollGoldLight}"
                                            VerticalOptions="Center" />
                                        <Label
                                            x:Name="ToolDrawLabel"
                                            Text="D"
                                            FontFamily="EBGaramondRegular"
                                            FontSize="13"
                                            TextColor="{StaticResource DMScrollGoldLight}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Move tool -->
                                <Border
                                    x:Name="ToolMoveBorder"
                                    Grid.Column="2"
                                    BackgroundColor="Transparent"
                                    Stroke="Transparent"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 3"
                                    Padding="8,4"
                                    ToolTipProperties.Text="Move areas (M)">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnToolMoveClicked" />
                                    </Border.GestureRecognizers>
                                    <Border.Behaviors>
                                        <behaviors:HandCursorBehavior />
                                    </Border.Behaviors>
                                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                        <Label
                                            x:Name="ToolMoveIcon"
                                            Text="&#xE9D9;"
                                            FontFamily="RpgAwesome"
                                            FontSize="17"
                                            TextColor="{StaticResource DMTextMuted}"
                                            VerticalOptions="Center" />
                                        <Label
                                            x:Name="ToolMoveLabel"
                                            Text="M"
                                            FontFamily="EBGaramondRegular"
                                            FontSize="13"
                                            TextColor="{StaticResource DMTextMuted}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Select tool — click an area on the map to enter it -->
                                <Border
                                    x:Name="ToolSelectBorder"
                                    Grid.Column="3"
                                    BackgroundColor="Transparent"
                                    Stroke="Transparent"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 3"
                                    Padding="8,4"
                                    ToolTipProperties.Text="Select area (S)">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnToolSelectClicked" />
                                    </Border.GestureRecognizers>
                                    <Border.Behaviors>
                                        <behaviors:HandCursorBehavior />
                                    </Border.Behaviors>
                                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                        <Label
                                            x:Name="ToolSelectIcon"
                                            Text="&#xE9B6;"
                                            FontFamily="RpgAwesome"
                                            FontSize="17"
                                            TextColor="{StaticResource DMTextMuted}"
                                            VerticalOptions="Center" />
                                        <Label
                                            x:Name="ToolSelectLabel"
                                            Text="S"
                                            FontFamily="EBGaramondRegular"
                                            FontSize="13"
                                            TextColor="{StaticResource DMTextMuted}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Erase tool — delete an area by clicking it on the canvas -->
                                <Border
                                    x:Name="ToolEraseBorder"
                                    Grid.Column="4"
                                    BackgroundColor="Transparent"
                                    Stroke="Transparent"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 3"
                                    Padding="8,4"
                                    ToolTipProperties.Text="Erase area (E)">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnToolEraseClicked" />
                                    </Border.GestureRecognizers>
                                    <Border.Behaviors>
                                        <behaviors:HandCursorBehavior />
                                    </Border.Behaviors>
                                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                        <Label
                                            x:Name="ToolEraseIcon"
                                            Text="&#xE936;"
                                            FontFamily="RpgAwesome"
                                            FontSize="17"
                                            TextColor="{StaticResource DMTextMuted}"
                                            VerticalOptions="Center" />
                                        <Label
                                            x:Name="ToolEraseLabel"
                                            Text="E"
                                            FontFamily="EBGaramondRegular"
                                            FontSize="13"
                                            TextColor="{StaticResource DMTextMuted}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Pan tool -->
                                <Border
                                    x:Name="ToolPanBorder"
                                    Grid.Column="5"
                                    BackgroundColor="Transparent"
                                    Stroke="Transparent"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 3"
                                    Padding="8,4"
                                    ToolTipProperties.Text="Pan / scroll (H)">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnToolPanClicked" />
                                    </Border.GestureRecognizers>
                                    <Border.Behaviors>
                                        <behaviors:HandCursorBehavior />
                                    </Border.Behaviors>
                                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                        <Label
                                            x:Name="ToolPanIcon"
                                            Text="&#xEA78;"
                                            FontFamily="RpgAwesome"
                                            FontSize="17"
                                            TextColor="{StaticResource DMTextMuted}"
                                            VerticalOptions="Center" />
                                        <Label
                                            x:Name="ToolPanLabel"
                                            Text="H"
                                            FontFamily="EBGaramondRegular"
                                            FontSize="13"
                                            TextColor="{StaticResource DMTextMuted}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>

                            </Grid>

                            <!-- Area context: back + area name + redraw + place + pan -->
                            <Grid x:Name="AreaContextToolbar" IsVisible="False"
                                  ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="4">

                                <Button
                                    Grid.Column="0"
                                    Text="&#x25C4; Floor"
                                    FontFamily="EBGaramondRegular"
                                    FontSize="17"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource DMScrollGoldLight}"
                                    BorderColor="Transparent"
                                    BorderWidth="1"
                                    CornerRadius="3"
                                    Padding="8,4"
                                    Clicked="OnAreaContextBackClicked">
                                    <Button.Behaviors>
                                        <behaviors:HandCursorBehavior />
                                    </Button.Behaviors>
                                </Button>

                                <controls:DmInlineEditor
                                    x:Name="AreaNameToolbarEditor"
                                    Grid.Column="1"
                                    FontFamily="EBGaramondRegular"
                                    FontSize="17"
                                    AcceptsReturn="False"
                                    Placeholder="Area name..."
                                    TextCommitted="OnAreaNameToolbarCommitted"
                                    VerticalOptions="Center" />

                                <!-- Place tool (area context only — objects belong to areas) -->
                                <Border
                                    x:Name="ToolPlaceBorder"
                                    Grid.Column="2"
                                    BackgroundColor="Transparent"
                                    Stroke="Transparent"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 3"
                                    Padding="8,4"
                                    ToolTipProperties.Text="Place objects (P)">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnToolPlaceClicked" />
                                    </Border.GestureRecognizers>
                                    <Border.Behaviors>
                                        <behaviors:HandCursorBehavior />
                                    </Border.Behaviors>
                                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                        <Label
                                            x:Name="ToolPlaceIcon"
                                            Text="&#xE9B8;"
                                            FontFamily="RpgAwesome"
                                            FontSize="17"
                                            TextColor="{StaticResource DMTextMuted}"
                                            VerticalOptions="Center" />
                                        <Label
                                            x:Name="ToolPlaceLabel"
                                            Text="P"
                                            FontFamily="EBGaramondRegular"
                                            FontSize="13"
                                            TextColor="{StaticResource DMTextMuted}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Pan tool (area context) -->
                                <Border
                                    x:Name="ToolPanAreaBorder"
                                    Grid.Column="3"
                                    BackgroundColor="Transparent"
                                    Stroke="Transparent"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 3"
                                    Padding="8,4"
                                    ToolTipProperties.Text="Pan / scroll (H)">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnToolPanClicked" />
                                    </Border.GestureRecognizers>
                                    <Border.Behaviors>
                                        <behaviors:HandCursorBehavior />
                                    </Border.Behaviors>
                                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                        <Label
                                            x:Name="ToolPanAreaIcon"
                                            Text="&#xEA78;"
                                            FontFamily="RpgAwesome"
                                            FontSize="17"
                                            TextColor="{StaticResource DMTextMuted}"
                                            VerticalOptions="Center" />
                                        <Label
                                            x:Name="ToolPanAreaLabel"
                                            Text="H"
                                            FontFamily="EBGaramondRegular"
                                            FontSize="13"
                                            TextColor="{StaticResource DMTextMuted}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Redraw tool -->
                                <Border
                                    x:Name="ToolRedrawBorder"
                                    Grid.Column="4"
                                    BackgroundColor="Transparent"
                                    Stroke="Transparent"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 3"
                                    Padding="8,4"
                                    ToolTipProperties.Text="Redraw area outline (D)">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnToolRedrawClicked" />
                                    </Border.GestureRecognizers>
                                    <Border.Behaviors>
                                        <behaviors:HandCursorBehavior />
                                    </Border.Behaviors>
                                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                        <Label
                                            x:Name="ToolRedrawIcon"
                                            Text="&#xEA75;"
                                            FontFamily="RpgAwesome"
                                            FontSize="17"
                                            TextColor="{StaticResource DMTextMuted}"
                                            VerticalOptions="Center" />
                                        <Label
                                            x:Name="ToolRedrawLabel"
                                            Text="D"
                                            FontFamily="EBGaramondRegular"
                                            FontSize="13"
                                            TextColor="{StaticResource DMTextMuted}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>

                            </Grid>

                        </Grid>

                        <!-- Right: always-visible Undo / Save / Discard -->
                        <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">

                            <Button
                                x:Name="UndoButton"
                                Text="&#x21A9; Undo"
                                FontFamily="EBGaramondRegular"
                                FontSize="15"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource DMScrollGoldLight}"
                                BorderColor="Transparent"
                                BorderWidth="1"
                                CornerRadius="3"
                                Padding="8,4"
                                IsEnabled="False"
                                Opacity="0.35"
                                ToolTipProperties.Text="Undo last vertex"
                                Clicked="OnUndoClicked">
                                <Button.Behaviors>
                                    <behaviors:HandCursorBehavior />
                                </Button.Behaviors>
                            </Button>

                        </HorizontalStackLayout>

                    </Grid>
                </Border>

                <!-- Map canvas + zoom overlay -->
                <Grid x:Name="MapOverlay" Grid.Row="1">
                    <GraphicsView
                        x:Name="MapCanvas"
                        StartInteraction="OnMapStartInteraction"
                        DragInteraction="OnMapDragInteraction"
                        EndInteraction="OnMapEndInteraction"
                        MoveHoverInteraction="OnMapMoveHover"
                        EndHoverInteraction="OnMapEndHover">
                        <GraphicsView.GestureRecognizers>
                            <TapGestureRecognizer NumberOfTapsRequired="2" Tapped="OnMapDoubleTapped" />
                            <TapGestureRecognizer Buttons="Secondary" Tapped="OnMapSecondaryTapped" />
                        </GraphicsView.GestureRecognizers>
                    </GraphicsView>
                    <VerticalStackLayout
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        Margin="0,8,12,0"
                        Spacing="2"
                        InputTransparent="False">
                        <!-- Zoom in — upward triangle -->
                        <Grid WidthRequest="42" HeightRequest="36">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnZoomInClicked" />
                            </Grid.GestureRecognizers>
                            <Grid.Behaviors>
                                <behaviors:HandCursorBehavior />
                            </Grid.Behaviors>
                            <Polygon Points="21,1 41,35 1,35"
                                     Fill="#3D2E12"
                                     Stroke="#C8A040"
                                     StrokeThickness="1"
                                     HorizontalOptions="Fill"
                                     VerticalOptions="Fill" />
                            <Label Text="+"
                                   FontSize="20"
                                   TextColor="#F5E4B0"
                                   WidthRequest="42"
                                   HorizontalOptions="Fill"
                                   HorizontalTextAlignment="Center"
                                   VerticalOptions="End"
                                   Margin="0,0,0,0" />
                        </Grid>
                        <Label x:Name="ZoomPercentLabel"
                               Text="100%"
                               FontFamily="EBGaramondRegular"
                               FontSize="15"
                               TextColor="#F5E4B0"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               WidthRequest="42" />
                        <!-- Zoom out — downward triangle -->
                        <Grid WidthRequest="42" HeightRequest="36">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnZoomOutClicked" />
                            </Grid.GestureRecognizers>
                            <Grid.Behaviors>
                                <behaviors:HandCursorBehavior />
                            </Grid.Behaviors>
                            <Polygon Points="1,1 41,1 21,35"
                                     Fill="#3D2E12"
                                     Stroke="#C8A040"
                                     StrokeThickness="1"
                                     HorizontalOptions="Fill"
                                     VerticalOptions="Fill" />
                            <Label Text="−"
                                   FontSize="20"
                                   TextColor="#F5E4B0"
                                   WidthRequest="42"
                                   HorizontalOptions="Fill"
                                   HorizontalTextAlignment="Center"
                                   VerticalOptions="Start"
                                   Margin="0,0,0,0" />
                        </Grid>
                    </VerticalStackLayout>
                    <palette:ObjectPaletteView
                        x:Name="ObjectPalette"
                        HorizontalOptions="Start"
                        VerticalOptions="End"
                        Margin="8,0,0,8"
                        IsVisible="False" />
                    <!-- Object action popup: rotate CCW, rotate CW, delete -->
                    <Border x:Name="ObjectActionPopup"
                            IsVisible="False"
                            BackgroundColor="#1A1610"
                            Stroke="#4a3a1a"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 3"
                            Padding="4"
                            HorizontalOptions="Start"
                            VerticalOptions="Start">
                        <HorizontalStackLayout Spacing="2">
                            <Border x:Name="PopupBtnCCW"
                                    WidthRequest="36" HeightRequest="36"
                                    BackgroundColor="Transparent"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 2">
                                <Label Text="↺"
                                       FontSize="22"
                                       TextColor="#C8A040"
                                       Rotation="-90"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       InputTransparent="True" />
                            </Border>
                            <Border x:Name="PopupBtnCW"
                                    WidthRequest="36" HeightRequest="36"
                                    BackgroundColor="Transparent"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 2">
                                <Label Text="↻"
                                       FontSize="22"
                                       TextColor="#C8A040"
                                       Rotation="90"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       InputTransparent="True" />
                            </Border>
                            <Border x:Name="PopupBtnDelete"
                                    WidthRequest="36" HeightRequest="36"
                                    BackgroundColor="Transparent"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 2">
                                <Label Text="&#xE9FC;"
                                       FontFamily="RpgAwesome"
                                       FontSize="22"
                                       TextColor="#CC3030"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       InputTransparent="True" />
                            </Border>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </Grid>

            <!-- RIGHT SIDEBAR -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*" BackgroundColor="Transparent">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSidebarTapped" />
                </Grid.GestureRecognizers>

                <!-- Sidebar header -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <Label
                        Grid.Column="0"
                        Text="FLOORS"
                        FontFamily="CinzelRegular"
                        FontSize="17"
                        CharacterSpacing="1"
                        TextColor="{StaticResource DMScrollGoldLight}"
                        VerticalOptions="Center" />
                    <Button
                        Grid.Column="1"
                        Text="+ Add Floor"
                        FontFamily="EBGaramondRegular"
                        FontSize="18"
                        TextColor="{StaticResource DMScrollGoldLight}"
                        BackgroundColor="Transparent"
                        Padding="4,2"
                        Clicked="OnAddFloorClicked">
                        <Button.Behaviors>
                            <behaviors:HandCursorBehavior />
                        </Button.Behaviors>
                    </Button>
                </Grid>

                <!-- Floor list (built in code-behind) -->
                <ScrollView Grid.Row="1">
                    <VerticalStackLayout x:Name="FloorListContainer" Spacing="0" />
                </ScrollView>

            </Grid>
        </Grid>
    </Grid>
</ContentPage>
