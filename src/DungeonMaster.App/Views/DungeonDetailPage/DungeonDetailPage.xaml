<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DungeonMaster.App.Controls"
    xmlns:behaviors="clr-namespace:DungeonMaster.App.Behaviors"
    xmlns:vm="clr-namespace:DungeonMaster.App.ViewModels"
    xmlns:palette="clr-namespace:DungeonMaster.App.Views.DungeonDetail"
    x:Class="DungeonMaster.App.Views.DungeonDetailPage"
    x:DataType="vm:DungeonDetailViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource DMBackground}">

    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="0" Padding="16,12,16,0">

        <!-- Row 0: Top nav bar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
            <Button
                Grid.Column="0"
                Text="&#x2190; Back"
                FontFamily="EBGaramondRegular"
                FontSize="20"
                BackgroundColor="Transparent"
                TextColor="{StaticResource DMScrollGoldLight}"
                Padding="0,4"
                Clicked="OnBackClicked">
                <Button.Behaviors>
                    <behaviors:HandCursorBehavior />
                </Button.Behaviors>
            </Button>

            <HorizontalStackLayout
                Grid.Column="1"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="6">
                <Label
                    Text="&#xEA75;"
                    FontFamily="RpgAwesome"
                    FontSize="14"
                    TextColor="{StaticResource DMTextMuted}"
                    VerticalOptions="Center" />
                <Label
                    Text="DUNGEON EDITOR"
                    FontFamily="CinzelRegular"
                    FontSize="12"
                    CharacterSpacing="1.5"
                    TextColor="{StaticResource DMTextMuted}"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Grid Grid.Column="2">
                <Button
                    Text="Start Session"
                    FontFamily="EBGaramondRegular"
                    FontSize="20"
                    BackgroundColor="{StaticResource DMConfirm}"
                    TextColor="{StaticResource DMConfirmText}"
                    CornerRadius="3"
                    Padding="36,6,12,6"
                    IsEnabled="{Binding Dungeon.FloorCount, Converter={StaticResource GreaterThanZeroConverter}}">
                    <Button.Behaviors>
                        <behaviors:HandCursorBehavior />
                    </Button.Behaviors>
                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                            Binding="{Binding Dungeon.FloorCount, Converter={StaticResource GreaterThanZeroConverter}}"
                            Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <!-- Crossed-sword icon overlaid on the left of the button -->
                <Label Text="&#xE97D;"
                       FontFamily="RpgAwesome"
                       FontSize="16"
                       TextColor="{StaticResource DMConfirmText}"
                       HorizontalOptions="Start"
                       VerticalOptions="Center"
                       Margin="12,0,0,0"
                       InputTransparent="True" />
                <!-- Transparent overlay carries tooltip when button is disabled -->
                <BoxView
                    BackgroundColor="Transparent"
                    IsVisible="{Binding Dungeon.FloorCount, Converter={StaticResource GreaterThanZeroConverter}, ConverterParameter=Invert}"
                    ToolTipProperties.Text="Add at least one floor before starting a session"
                    InputTransparent="False" />
            </Grid>
        </Grid>

        <!-- Row 1: Full-width DmFlagBanner -->
        <controls:DmFlagBanner
            x:Name="TitleBanner"
            Grid.Row="1"
            IsEditable="True"
            Title="{Binding Dungeon.Name}"
            TextCommitted="OnDungeonNameCommitted" />

        <!-- Row 2: Decorative divider between the banner and the map -->
        <controls:DmDivider
            Grid.Row="2"
            Margin="0,6,0,4" />

        <!-- Row 3: Map canvas (left) | Floors sidebar (right) -->
        <Grid Grid.Row="3" ColumnDefinitions="*,300" ColumnSpacing="16">

            <!-- LEFT COLUMN: toolbar (edit mode only) + map canvas -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*">

                <!-- Map toolbar (hidden until a floor is selected) -->
                <Border x:Name="MapToolbar" Grid.Row="0" IsVisible="False"
                        BackgroundColor="{StaticResource DMCardSurface}"
                        Stroke="{StaticResource DMCardBorderBrush}"
                        StrokeShape="RoundRectangle 3"
                        StrokeThickness="1"
                        Padding="6,4"
                        Margin="0,0,0,4">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">

                        <!-- Left: context-switching area -->
                        <Grid Grid.Column="0">

                            <!-- Floor context: drawing tools. Names are edited in the notebook. -->
                            <Grid x:Name="FloorContextToolbar" IsVisible="True"
                                  ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="4">

                                <!-- Draw tool — active by default -->
                                <Border
                                    x:Name="ToolDrawBorder"
                                    Grid.Column="0"
                                    BackgroundColor="Transparent"
                                    Stroke="{StaticResource DMScrollGoldLight}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 3"
                                    Padding="8,4"
                                    ToolTipProperties.Text="Draw area (D)">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnToolDrawClicked" />
                                    </Border.GestureRecognizers>
                                    <Border.Behaviors>
                                        <behaviors:HandCursorBehavior />
                                    </Border.Behaviors>
                                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                        <Label
                                            x:Name="ToolDrawIcon"
                                            Text="&#xEA75;"
                                            FontFamily="RpgAwesome"
                                            FontSize="17"
                                            TextColor="{StaticResource DMScrollGoldLight}"
                                            VerticalOptions="Center" />
                                        <Label
                                            x:Name="ToolDrawLabel"
                                            Text="D"
                                            FontFamily="EBGaramondRegular"
                                            FontSize="13"
                                            TextColor="{StaticResource DMScrollGoldLight}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Move tool -->
                                <Border
                                    x:Name="ToolMoveBorder"
                                    Grid.Column="1"
                                    BackgroundColor="Transparent"
                                    Stroke="Transparent"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 3"
                                    Padding="8,4"
                                    ToolTipProperties.Text="Move areas (M)">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnToolMoveClicked" />
                                    </Border.GestureRecognizers>
                                    <Border.Behaviors>
                                        <behaviors:HandCursorBehavior />
                                    </Border.Behaviors>
                                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                        <Label
                                            x:Name="ToolMoveIcon"
                                            Text="&#xE9D9;"
                                            FontFamily="RpgAwesome"
                                            FontSize="17"
                                            TextColor="{StaticResource DMTextMuted}"
                                            VerticalOptions="Center" />
                                        <Label
                                            x:Name="ToolMoveLabel"
                                            Text="M"
                                            FontFamily="EBGaramondRegular"
                                            FontSize="13"
                                            TextColor="{StaticResource DMTextMuted}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Select tool — click a placed object on the map to select it -->
                                <Border
                                    x:Name="ToolSelectBorder"
                                    Grid.Column="2"
                                    BackgroundColor="Transparent"
                                    Stroke="Transparent"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 3"
                                    Padding="8,4"
                                    ToolTipProperties.Text="Select area (S)">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnToolSelectClicked" />
                                    </Border.GestureRecognizers>
                                    <Border.Behaviors>
                                        <behaviors:HandCursorBehavior />
                                    </Border.Behaviors>
                                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                        <Label
                                            x:Name="ToolSelectIcon"
                                            Text="&#xE9B6;"
                                            FontFamily="RpgAwesome"
                                            FontSize="17"
                                            TextColor="{StaticResource DMTextMuted}"
                                            VerticalOptions="Center" />
                                        <Label
                                            x:Name="ToolSelectLabel"
                                            Text="S"
                                            FontFamily="EBGaramondRegular"
                                            FontSize="13"
                                            TextColor="{StaticResource DMTextMuted}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Erase tool — delete an area by clicking it on the canvas -->
                                <Border
                                    x:Name="ToolEraseBorder"
                                    Grid.Column="3"
                                    BackgroundColor="Transparent"
                                    Stroke="Transparent"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 3"
                                    Padding="8,4"
                                    ToolTipProperties.Text="Erase area (E)">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnToolEraseClicked" />
                                    </Border.GestureRecognizers>
                                    <Border.Behaviors>
                                        <behaviors:HandCursorBehavior />
                                    </Border.Behaviors>
                                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                        <Label
                                            x:Name="ToolEraseIcon"
                                            Text="&#xE936;"
                                            FontFamily="RpgAwesome"
                                            FontSize="17"
                                            TextColor="{StaticResource DMTextMuted}"
                                            VerticalOptions="Center" />
                                        <Label
                                            x:Name="ToolEraseLabel"
                                            Text="E"
                                            FontFamily="EBGaramondRegular"
                                            FontSize="13"
                                            TextColor="{StaticResource DMTextMuted}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Place tool — place objects anywhere on the floor -->
                                <Border
                                    x:Name="ToolPlaceBorder"
                                    Grid.Column="4"
                                    BackgroundColor="Transparent"
                                    Stroke="Transparent"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 3"
                                    Padding="8,4"
                                    ToolTipProperties.Text="Place objects (P)">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnToolPlaceClicked" />
                                    </Border.GestureRecognizers>
                                    <Border.Behaviors>
                                        <behaviors:HandCursorBehavior />
                                    </Border.Behaviors>
                                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                        <Label
                                            x:Name="ToolPlaceIcon"
                                            Text="&#xE9B8;"
                                            FontFamily="RpgAwesome"
                                            FontSize="17"
                                            TextColor="{StaticResource DMTextMuted}"
                                            VerticalOptions="Center" />
                                        <Label
                                            x:Name="ToolPlaceLabel"
                                            Text="P"
                                            FontFamily="EBGaramondRegular"
                                            FontSize="13"
                                            TextColor="{StaticResource DMTextMuted}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Pan tool -->
                                <Border
                                    x:Name="ToolPanBorder"
                                    Grid.Column="5"
                                    BackgroundColor="Transparent"
                                    Stroke="Transparent"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 3"
                                    Padding="8,4"
                                    ToolTipProperties.Text="Pan / scroll (H)">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnToolPanClicked" />
                                    </Border.GestureRecognizers>
                                    <Border.Behaviors>
                                        <behaviors:HandCursorBehavior />
                                    </Border.Behaviors>
                                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                        <Label
                                            x:Name="ToolPanIcon"
                                            Text="&#xEA78;"
                                            FontFamily="RpgAwesome"
                                            FontSize="17"
                                            TextColor="{StaticResource DMTextMuted}"
                                            VerticalOptions="Center" />
                                        <Label
                                            x:Name="ToolPanLabel"
                                            Text="H"
                                            FontFamily="EBGaramondRegular"
                                            FontSize="13"
                                            TextColor="{StaticResource DMTextMuted}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>

                            </Grid>

                        </Grid>

                        <!-- Right: always-visible Undo / Save / Discard -->
                        <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">

                            <Button
                                x:Name="UndoButton"
                                Text="&#x21A9; Undo"
                                FontFamily="EBGaramondRegular"
                                FontSize="15"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource DMScrollGoldLight}"
                                BorderColor="Transparent"
                                BorderWidth="1"
                                CornerRadius="3"
                                Padding="8,4"
                                IsEnabled="False"
                                Opacity="0.35"
                                ToolTipProperties.Text="Undo last vertex"
                                Clicked="OnUndoClicked">
                                <Button.Behaviors>
                                    <behaviors:HandCursorBehavior />
                                </Button.Behaviors>
                            </Button>

                        </HorizontalStackLayout>

                    </Grid>
                </Border>

                <!-- Map canvas + zoom overlay -->
                <Grid x:Name="MapOverlay" Grid.Row="1">
                    <GraphicsView
                        x:Name="MapCanvas"
                        StartInteraction="OnMapStartInteraction"
                        DragInteraction="OnMapDragInteraction"
                        EndInteraction="OnMapEndInteraction"
                        MoveHoverInteraction="OnMapMoveHover"
                        EndHoverInteraction="OnMapEndHover">
                        <GraphicsView.GestureRecognizers>
                            <TapGestureRecognizer NumberOfTapsRequired="2" Tapped="OnMapDoubleTapped" />
                            <TapGestureRecognizer Buttons="Secondary" Tapped="OnMapSecondaryTapped" />
                        </GraphicsView.GestureRecognizers>
                    </GraphicsView>
                    <VerticalStackLayout
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        Margin="0,8,12,0"
                        Spacing="2"
                        InputTransparent="False">
                        <!-- Zoom in — upward triangle -->
                        <Grid WidthRequest="42" HeightRequest="36">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnZoomInClicked" />
                            </Grid.GestureRecognizers>
                            <Grid.Behaviors>
                                <behaviors:HandCursorBehavior />
                            </Grid.Behaviors>
                            <Polygon Points="21,1 41,35 1,35"
                                     Fill="#3D2E12"
                                     Stroke="#C8A040"
                                     StrokeThickness="1"
                                     HorizontalOptions="Fill"
                                     VerticalOptions="Fill" />
                            <Label Text="+"
                                   FontSize="20"
                                   TextColor="#F5E4B0"
                                   WidthRequest="42"
                                   HorizontalOptions="Fill"
                                   HorizontalTextAlignment="Center"
                                   VerticalOptions="End"
                                   Margin="0,0,0,0" />
                        </Grid>
                        <Label x:Name="ZoomPercentLabel"
                               Text="100%"
                               FontFamily="EBGaramondRegular"
                               FontSize="15"
                               TextColor="#F5E4B0"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               WidthRequest="42" />
                        <!-- Zoom out — downward triangle -->
                        <Grid WidthRequest="42" HeightRequest="36">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnZoomOutClicked" />
                            </Grid.GestureRecognizers>
                            <Grid.Behaviors>
                                <behaviors:HandCursorBehavior />
                            </Grid.Behaviors>
                            <Polygon Points="1,1 41,1 21,35"
                                     Fill="#3D2E12"
                                     Stroke="#C8A040"
                                     StrokeThickness="1"
                                     HorizontalOptions="Fill"
                                     VerticalOptions="Fill" />
                            <Label Text="−"
                                   FontSize="20"
                                   TextColor="#F5E4B0"
                                   WidthRequest="42"
                                   HorizontalOptions="Fill"
                                   HorizontalTextAlignment="Center"
                                   VerticalOptions="Start"
                                   Margin="0,0,0,0" />
                        </Grid>
                    </VerticalStackLayout>
                    <VerticalStackLayout
                        HorizontalOptions="Start"
                        VerticalOptions="End"
                        Margin="8,0,0,8"
                        Spacing="4">
                        <palette:ControlsPaletteView
                            x:Name="ControlsPalette"
                            IsVisible="False" />
                        <palette:ObjectPaletteView
                            x:Name="ObjectPalette"
                            IsVisible="False" />
                    </VerticalStackLayout>
                    <!-- Object action popup: rotate CCW/CW | resize − /+ | delete -->
                    <Border x:Name="ObjectActionPopup"
                            IsVisible="False"
                            BackgroundColor="#1A1610"
                            Stroke="#4a3a1a"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 3"
                            Padding="4"
                            HorizontalOptions="Start"
                            VerticalOptions="Start">
                        <HorizontalStackLayout Spacing="2">
                            <Border x:Name="PopupBtnCCW"
                                    WidthRequest="32" HeightRequest="32"
                                    BackgroundColor="Transparent"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 2">
                                <Label Text="↺"
                                       FontSize="20"
                                       TextColor="#C8A040"
                                       Rotation="-90"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       InputTransparent="True" />
                            </Border>
                            <Border x:Name="PopupBtnCW"
                                    WidthRequest="32" HeightRequest="32"
                                    BackgroundColor="Transparent"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 2">
                                <Label Text="↻"
                                       FontSize="20"
                                       TextColor="#C8A040"
                                       Rotation="90"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       InputTransparent="True" />
                            </Border>
                            <BoxView WidthRequest="1" HeightRequest="18"
                                     Color="#3a2e1a"
                                     VerticalOptions="Center" />
                            <Border x:Name="PopupBtnScaleDown"
                                    WidthRequest="32" HeightRequest="32"
                                    BackgroundColor="Transparent"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 2">
                                <Label Text="−"
                                       FontSize="20"
                                       TextColor="#C8A040"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       InputTransparent="True" />
                            </Border>
                            <Border x:Name="PopupBtnScaleUp"
                                    WidthRequest="32" HeightRequest="32"
                                    BackgroundColor="Transparent"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 2">
                                <Label Text="+"
                                       FontSize="20"
                                       TextColor="#C8A040"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       InputTransparent="True" />
                            </Border>
                            <BoxView WidthRequest="1" HeightRequest="18"
                                     Color="#3a2e1a"
                                     VerticalOptions="Center" />
                            <Border x:Name="PopupBtnDelete"
                                    WidthRequest="32" HeightRequest="32"
                                    BackgroundColor="Transparent"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 2">
                                <Label Text="&#xE9FC;"
                                       FontFamily="RpgAwesome"
                                       FontSize="20"
                                       TextColor="#CC3030"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       InputTransparent="True" />
                            </Border>
                        </HorizontalStackLayout>
                    </Border>

                    <!--
                        The notebook floats over the map and is dragged by its header, so it is the
                        last child: anything added after it would sit on top of the page the user
                        is writing on.
                    -->
                    <controls:NotebookView
                        x:Name="Notebook"
                        IsVisible="False"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        Margin="16,12,0,0" />
                </Grid>
            </Grid>

            <!-- RIGHT SIDEBAR -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*" BackgroundColor="Transparent">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSidebarTapped" />
                </Grid.GestureRecognizers>

                <!-- Sidebar header -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <Label
                        Grid.Column="0"
                        Text="FLOORS"
                        FontFamily="CinzelRegular"
                        FontSize="17"
                        CharacterSpacing="1"
                        TextColor="{StaticResource DMScrollGoldLight}"
                        VerticalOptions="Center" />
                    <Button
                        Grid.Column="1"
                        Text="+ Add Floor"
                        FontFamily="EBGaramondRegular"
                        FontSize="18"
                        TextColor="{StaticResource DMScrollGoldLight}"
                        BackgroundColor="Transparent"
                        Padding="4,2"
                        Clicked="OnAddFloorClicked">
                        <Button.Behaviors>
                            <behaviors:HandCursorBehavior />
                        </Button.Behaviors>
                    </Button>
                </Grid>

                <!-- Floor list (built in code-behind) + dungeon-level notebook row -->
                <ScrollView Grid.Row="1">
                    <VerticalStackLayout Spacing="0">
                        <VerticalStackLayout x:Name="FloorListContainer" Spacing="0" />

                        <!-- Dungeon-level row — always visible, styled like a floor card -->
                        <Border
                            StrokeShape="RoundRectangle 3"
                            StrokeThickness="1"
                            Stroke="{StaticResource DMCardBorderBrush}"
                            BackgroundColor="{StaticResource DMCardSurface}"
                            Padding="8,6"
                            Margin="0,4,0,4">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <Label
                                    Grid.Column="0"
                                    Text="{Binding Dungeon.Name}"
                                    FontFamily="CinzelSemiBold"
                                    FontSize="16"
                                    TextColor="{StaticResource DMScrollGoldLight}"
                                    VerticalOptions="Center" />
                                <Button
                                    x:Name="DungeonNotebookButton"
                                    Grid.Column="1"
                                    Text="&#xEA8F;"
                                    FontFamily="RpgAwesome"
                                    FontSize="14"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource DMInkMuted}"
                                    Padding="4,0"
                                    CornerRadius="2"
                                    ToolTipProperties.Text="Open notebook"
                                    Clicked="OnDungeonNotebookClicked">
                                    <Button.Behaviors>
                                        <behaviors:HandCursorBehavior />
                                    </Button.Behaviors>
                                </Button>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>

            </Grid>
        </Grid>
    </Grid>
</ContentPage>
