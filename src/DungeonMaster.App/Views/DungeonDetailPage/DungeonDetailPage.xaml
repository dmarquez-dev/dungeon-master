<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DungeonMaster.App.Controls"
    xmlns:behaviors="clr-namespace:DungeonMaster.App.Behaviors"
    xmlns:vm="clr-namespace:DungeonMaster.App.ViewModels"
    xmlns:palette="clr-namespace:DungeonMaster.App.Views.DungeonDetail"
    x:Class="DungeonMaster.App.Views.DungeonDetailPage"
    x:DataType="vm:DungeonDetailViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource DmSurfaceTavern}">

    <ContentPage.Resources>
        <!-- The five square icon buttons of the object-action popup. Only their chrome is shared
             — the content of each differs (a rotated glyph, a shape, an icon codepoint), so a
             Style is as far as this factors.

             StrokeShape is deliberately NOT set here. Wave 2a proved that an element-form
             RoundRectangle inside a Setter is a single instance shared by every Border the style
             touches, mutable through any one of them and reporting the last of them as its
             parent; each Border therefore declares its own. -->
        <Style x:Key="PopupIconButton" TargetType="Border">
            <Setter Property="WidthRequest" Value="32" />
            <Setter Property="HeightRequest" Value="32" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="StrokeThickness" Value="0" />
        </Style>
    </ContentPage.Resources>

    <!-- Page inset with the bottom edge deliberately suppressed: the map canvas and the floor
         sidebar are the last row and run to the window edge, so a bottom inset would leave a
         strip of tavern background under them. Left/right/top are DmPaddingPage's 16,12. -->
    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="0" Padding="16,12,16,0">

        <!-- Row 0: Top nav bar.
             Column 0 is deliberately empty. It used to hold an in-page "← Back" button, which
             duplicated the Shell's own back arrow in the Windows title bar — that arrow is
             present and working on this page even with Shell.NavBarIsVisible false, and it is
             what returns to the dungeon list now. Verified by clicking it, not by reading. -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
            <HorizontalStackLayout
                Grid.Column="1"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="{StaticResource DmSpaceSmall}">
                <!-- Decorative: the DUNGEON EDITOR wordmark beside it is the announcement, so
                     this glyph is kept out of the accessibility tree rather than described. -->
                <Label
                    Text="&#xEA75;"
                    FontFamily="{StaticResource DmFontIcon}"
                    FontSize="{StaticResource DmIconSizeSmall}"
                    TextColor="{StaticResource DmTextTavernMuted}"
                    AutomationProperties.IsInAccessibleTree="False"
                    VerticalOptions="Center" />
                <Label
                    Text="DUNGEON EDITOR"
                    FontFamily="{StaticResource DmFontTitle}"
                    FontSize="{StaticResource DmFontSizeEyebrow}"
                    CharacterSpacing="1.5"
                    TextColor="{StaticResource DmTextTavernMuted}"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Grid Grid.Column="2">
                <!-- Padding 36,6,12,6 below is an icon inset, not a role: the 36 on the leading
                     edge clears the crossed-sword Label overlaid on this button at Margin
                     12,0,0,0 further down, so the text starts clear of the glyph. -->
                <Button
                    Text="Start Session"
                    AutomationId="StartSessionButton"
                    FontFamily="{StaticResource DmFontBody}"
                    Padding="36,6,12,6"
                    FontSize="{StaticResource DmFontSizeBodyLarge}"
                    BackgroundColor="{StaticResource DmConfirm}"
                    TextColor="{StaticResource DmConfirmText}"
                    CornerRadius="{StaticResource DmRadiusDefault}"
                    IsEnabled="{Binding Dungeon.FloorCount, Converter={StaticResource GreaterThanZeroConverter}}">
                    <Button.Behaviors>
                        <behaviors:HandCursorBehavior />
                    </Button.Behaviors>
                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                            Binding="{Binding Dungeon.FloorCount, Converter={StaticResource GreaterThanZeroConverter}}"
                            Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <!-- Crossed-sword icon overlaid on the left of the button. Decorative: the
                     button it sits on is already labelled "Start Session". -->
                <Label Text="&#xE97D;"
                       FontFamily="{StaticResource DmFontIcon}"
                       FontSize="{StaticResource DmIconSizeMedium}"
                       TextColor="{StaticResource DmConfirmText}"
                       HorizontalOptions="Start"
                       VerticalOptions="Center"
                       Margin="12,0,0,0"
                       AutomationProperties.IsInAccessibleTree="False"
                       InputTransparent="True" />
                <!-- Transparent overlay carries tooltip when button is disabled -->
                <BoxView
                    BackgroundColor="Transparent"
                    IsVisible="{Binding Dungeon.FloorCount, Converter={StaticResource GreaterThanZeroConverter}, ConverterParameter=Invert}"
                    ToolTipProperties.Text="Add at least one floor before starting a session"
                    InputTransparent="False" />
            </Grid>
        </Grid>

        <!-- Row 1: Full-width DmFlagBanner (display-only — renamed via the sidebar card's notebook) -->
        <controls:DmFlagBanner
            x:Name="TitleBanner"
            Grid.Row="1"
            Title="{Binding Dungeon.Name}" />

        <!-- Row 2: Decorative divider between the banner and the map -->
        <controls:DmDivider
            Grid.Row="2"
            Margin="0,6,0,4" />

        <!-- Row 3: map toolbar + canvas (left) | dungeon card + floor list (right).

             Row 0 of THIS grid is shared by the map toolbar and the sidebar dungeon card, and
             that shared Auto row is the entire reason their bottom edges line up: it takes the
             height of whichever is taller, at the first frame, with nothing measured. The two
             used to be row 0 of two SEPARATE sub-grids, which is why they needed a hand-measured
             DmToolbarHeight constant to agree — a number read off a screenshot, which went stale
             silently whenever the toolbar's contents grew and clipped the tool tiles. -->
        <Grid Grid.Row="3"
              ColumnDefinitions="*,300"
              RowDefinitions="Auto,*"
              ColumnSpacing="{StaticResource DmSpaceXL}">

            <!-- Map toolbar. Hidden until a floor is selected with Opacity, NOT IsVisible: a
                 collapsed element contributes nothing to an Auto row, so IsVisible="False" would
                 let the shared row size itself to the dungeon card alone and then jump when the
                 first floor was picked. InputTransparent keeps it genuinely non-interactive for
                 as long as it is invisible.

                 DmBorderTavernStyle supplies the hairline stroke, the tavern border brush and
                 the DmRadiusDefault corner — the same three values this element used to spell
                 out. BackgroundColor is NOT one of them and is restated deliberately: the style
                 inherits BackgroundColor="Transparent" from DmBorderBase, so a Border with a
                 surface of its own has to say so again. -->

            <Border x:Name="MapToolbar"
                    Grid.Row="0"
                    Grid.Column="0"
                    Opacity="0"
                    InputTransparent="True"
                    Style="{StaticResource DmBorderTavernStyle}"
                    BackgroundColor="{StaticResource DmSurfaceTavernRaised}"
                    Padding="{StaticResource DmPaddingCompact}"
                    Margin="0,0,0,4">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource DmSpaceXS}">

                    <!-- Left: context-switching area.
                         Floor context: drawing tools. Names are edited in the notebook.

                         A HorizontalStackLayout, not a Grid: the six tiles are laid out
                         left-to-right at a uniform gap and nothing spans or aligns to a column,
                         so the seven ColumnDefinitions and six Grid.Column indices this used to
                         carry only bought the cost of renumbering them whenever a tool is added.
                         The trailing star column is gone too — the parent Grid's own star column
                         already absorbs the slack. -->
                    <HorizontalStackLayout
                        x:Name="FloorContextToolbar"
                        Grid.Column="0"
                        Spacing="{StaticResource DmSpaceXS}">

                        <palette:ToolTileView
                            x:Name="ToolDrawTile"
                            Glyph="&#xEA75;"
                            Shortcut="D"
                            AutomationId="ToolDrawTile"
                            ToolTipProperties.Text="Draw area (D)"
                            SemanticProperties.Description="Draw area"
                            SemanticProperties.Hint="Click the map to lay out an area's corners"
                            Clicked="OnToolDrawClicked" />

                        <palette:ToolTileView
                            x:Name="ToolMoveTile"
                            Glyph="&#xE9D9;"
                            Shortcut="M"
                            AutomationId="ToolMoveTile"
                            ToolTipProperties.Text="Move areas (M)"
                            SemanticProperties.Description="Move areas"
                            SemanticProperties.Hint="Drag an area on the map to reposition it"
                            Clicked="OnToolMoveClicked" />

                        <palette:ToolTileView
                            x:Name="ToolSelectTile"
                            Glyph="&#xE9B6;"
                            Shortcut="S"
                            AutomationId="ToolSelectTile"
                            ToolTipProperties.Text="Select area (S)"
                            SemanticProperties.Description="Select area"
                            SemanticProperties.Hint="Click an area or a placed object to select it"
                            Clicked="OnToolSelectClicked" />

                        <palette:ToolTileView
                            x:Name="ToolEraseTile"
                            Glyph="&#xE936;"
                            Shortcut="E"
                            AutomationId="ToolEraseTile"
                            ToolTipProperties.Text="Erase area (E)"
                            SemanticProperties.Description="Erase area"
                            SemanticProperties.Hint="Click an area on the map to delete it"
                            Clicked="OnToolEraseClicked" />

                        <palette:ToolTileView
                            x:Name="ToolPlaceTile"
                            Glyph="&#xE9B8;"
                            Shortcut="P"
                            AutomationId="ToolPlaceTile"
                            ToolTipProperties.Text="Place objects (P)"
                            SemanticProperties.Description="Place objects"
                            SemanticProperties.Hint="Opens the object palette, then click the map to place"
                            Clicked="OnToolPlaceClicked" />

                        <palette:ToolTileView
                            x:Name="ToolPanTile"
                            Glyph="&#xEA78;"
                            Shortcut="H"
                            AutomationId="ToolPanTile"
                            ToolTipProperties.Text="Pan / scroll (H)"
                            SemanticProperties.Description="Pan and scroll"
                            SemanticProperties.Hint="Drag the map to move the view without editing"
                            Clicked="OnToolPanClicked" />

                    </HorizontalStackLayout>

                    <!-- Right: always-visible Undo -->
                    <Button
                        x:Name="UndoButton"
                        Grid.Column="1"
                        Text="&#x21A9; Undo"
                        FontFamily="{StaticResource DmFontBody}"
                        FontSize="{StaticResource DmFontSizeBodySmall}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource DmAccentGoldLight}"
                        BorderColor="Transparent"
                        BorderWidth="{StaticResource DmStrokeHairline}"
                        CornerRadius="{StaticResource DmRadiusDefault}"
                        Padding="{StaticResource DmPaddingCompact}"
                        IsEnabled="False"
                        Opacity="0.35"
                        VerticalOptions="Center"
                        AutomationId="UndoButton"
                        SemanticProperties.Description="Undo last vertex"
                        ToolTipProperties.Text="Undo last vertex"
                        Clicked="OnUndoClicked">
                        <Button.Behaviors>
                            <behaviors:HandCursorBehavior />
                        </Button.Behaviors>
                    </Button>

                </Grid>
            </Border>

            <!-- Map canvas + zoom overlay -->
            <Grid x:Name="MapOverlay" Grid.Row="1" Grid.Column="0">
                <GraphicsView
                    x:Name="MapCanvas"
                    StartInteraction="OnMapStartInteraction"
                    DragInteraction="OnMapDragInteraction"
                    EndInteraction="OnMapEndInteraction"
                    MoveHoverInteraction="OnMapMoveHover"
                    EndHoverInteraction="OnMapEndHover">
                    <GraphicsView.GestureRecognizers>
                        <TapGestureRecognizer NumberOfTapsRequired="2" Tapped="OnMapDoubleTapped" />
                        <TapGestureRecognizer Buttons="Secondary" Tapped="OnMapSecondaryTapped" />
                    </GraphicsView.GestureRecognizers>
                </GraphicsView>
                <VerticalStackLayout
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    Margin="0,8,12,0"
                    Spacing="{StaticResource DmSpaceXXS}"
                    InputTransparent="False">

                    <!--
                        THE ZOOM GLYPHS ARE SHAPES, NOT TEXT.

                        A plus is two straight lines and a minus is one, so both are drawn as a
                        Path in the SAME coordinate space as the Polygon they sit on — the 42x36
                        stepper cell, Aspect left at its default so the numbers below are absolute
                        DIU, exactly like the Polygon's Points.

                        This is what the two measured TranslationYs (+3.1 and -8.3) used to buy,
                        badly. Each was a font's ink offset — a text font's ink does not sit
                        centred in its line box, and VerticalTextAlignment centres the LINE BOX,
                        not the ink inside it — MIXED WITH a compensation for the fact that a
                        triangle's centroid is not its bounding box's centre. Two components of
                        opposite sign in one number, read off a screenshot, and only the ink half
                        would have gone away when the icon font changed.

                        Both numbers below are derivable instead of measured. The horizontal
                        centre is the Polygon's own apex x (21). The vertical centre is the
                        triangle's centroid, the mean of its three vertex ys: (1+35+35)/3 = 23.7
                        for the upward stepper, (1+1+35)/3 = 12.3 for the downward one.

                        The lengths reproduce what EB Garamond rendered at DmIconSizeXL (20): its
                        plus is 9.94 x 9.81 DIU and its minus 10.00 x 1.19.

                        The stroke weights do NOT come from the outline, and this is worth knowing
                        before anyone "corrects" them. Drawn at the outline's own 0.85 and 1.19 the
                        shapes came back visibly lighter than the text they replaced — 16.25 units
                        of ink against 23.90 for the plus, measured off two rendered frames at the
                        same window rect. DirectWrite darkens light-on-dark stems, so the glyph's
                        0.85 stem paints like 1.27 and its 1.19 bar like 1.43. A filled shape gets
                        no such help, so the weights below are the RENDERED weights, which is what
                        keeps the toolbar looking unchanged.
                    -->

                    <!-- Zoom in — upward triangle -->
                    <Grid WidthRequest="42" HeightRequest="36"
                          AutomationId="ZoomInStepper"
                          SemanticProperties.Description="Zoom in"
                          ToolTipProperties.Text="Zoom in">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnZoomInClicked" />
                        </Grid.GestureRecognizers>
                        <Grid.Behaviors>
                            <behaviors:HandCursorBehavior />
                        </Grid.Behaviors>
                        <Polygon Points="21,1 41,35 1,35"
                                 Fill="{StaticResource DmSurfaceStepper}"
                                 Stroke="{StaticResource DmAccentGoldLight}"
                                 StrokeThickness="{StaticResource DmStrokeHairline}"
                                 HorizontalOptions="Fill"
                                 VerticalOptions="Fill" />
                        <Path Data="M 16,23.7 H 26 M 21,18.7 V 28.7"
                              Stroke="{StaticResource DmTextTavern}"
                              StrokeThickness="1.25"
                              HorizontalOptions="Fill"
                              VerticalOptions="Fill"
                              InputTransparent="True" />
                    </Grid>
                    <Label x:Name="ZoomPercentLabel"
                           Text="100%"
                           FontFamily="{StaticResource DmFontBody}"
                           FontSize="{StaticResource DmFontSizeBodySmall}"
                           TextColor="{StaticResource DmTextTavern}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           AutomationId="ZoomPercentLabel"
                           WidthRequest="42" />
                    <!-- Zoom out — downward triangle -->
                    <Grid WidthRequest="42" HeightRequest="36"
                          AutomationId="ZoomOutStepper"
                          SemanticProperties.Description="Zoom out"
                          ToolTipProperties.Text="Zoom out">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnZoomOutClicked" />
                        </Grid.GestureRecognizers>
                        <Grid.Behaviors>
                            <behaviors:HandCursorBehavior />
                        </Grid.Behaviors>
                        <Polygon Points="1,1 41,1 21,35"
                                 Fill="{StaticResource DmSurfaceStepper}"
                                 Stroke="{StaticResource DmAccentGoldLight}"
                                 StrokeThickness="{StaticResource DmStrokeHairline}"
                                 HorizontalOptions="Fill"
                                 VerticalOptions="Fill" />
                        <Path Data="M 16,12.3 H 26"
                              Stroke="{StaticResource DmTextTavern}"
                              StrokeThickness="1.45"
                              HorizontalOptions="Fill"
                              VerticalOptions="Fill"
                              InputTransparent="True" />
                    </Grid>
                </VerticalStackLayout>
                <VerticalStackLayout
                    HorizontalOptions="Start"
                    VerticalOptions="End"
                    Margin="8,0,0,8"
                    Spacing="{StaticResource DmSpaceXS}">
                    <palette:ControlsPaletteView
                        x:Name="ControlsPalette"
                        IsVisible="False" />
                    <palette:ObjectPaletteView
                        x:Name="ObjectPalette"
                        IsVisible="False" />
                </VerticalStackLayout>
                <!-- Object action popup: rotate CCW/CW | resize − /+ | delete -->
                <Border x:Name="ObjectActionPopup"
                        IsVisible="False"
                        BackgroundColor="{StaticResource DmSurfacePopup}"
                        Stroke="{StaticResource DmBorderPopup}"
                        StrokeThickness="{StaticResource DmStrokeHairline}"
                        Padding="{StaticResource DmPaddingTight}"
                        HorizontalOptions="Start"
                        VerticalOptions="Start">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="{StaticResource DmRadiusDefault}" />
                    </Border.StrokeShape>
                    <HorizontalStackLayout Spacing="{StaticResource DmSpaceXXS}">
                        <!-- The arrows keep their measured translation: no bundled font carries a
                             rotation arrow as line work, so unlike the plus and minus below they
                             cannot become shapes without inventing the artwork. The Phosphor
                             migration replaces them and takes the numbers with it. Each is
                             corrected on X because Translation applies AFTER Rotation, in screen
                             space. -->
                        <Border x:Name="PopupBtnCCW"
                                Style="{StaticResource PopupIconButton}"
                                AutomationId="PopupBtnCCW"
                                SemanticProperties.Description="Rotate anticlockwise"
                                ToolTipProperties.Text="Rotate anticlockwise">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="{StaticResource DmRadiusTight}" />
                            </Border.StrokeShape>
                            <Label Text="↺"
                                   FontFamily="{StaticResource DmFontBody}"
                                   FontSize="{StaticResource DmIconSizeXL}"
                                   TextColor="{StaticResource DmAccentGoldLight}"
                                   Rotation="-90"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   TranslationX="-1.6"
                                   AutomationProperties.IsInAccessibleTree="False"
                                   InputTransparent="True" />
                        </Border>
                        <Border x:Name="PopupBtnCW"
                                Style="{StaticResource PopupIconButton}"
                                AutomationId="PopupBtnCW"
                                SemanticProperties.Description="Rotate clockwise"
                                ToolTipProperties.Text="Rotate clockwise">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="{StaticResource DmRadiusTight}" />
                            </Border.StrokeShape>
                            <Label Text="↻"
                                   FontFamily="{StaticResource DmFontBody}"
                                   FontSize="{StaticResource DmIconSizeXL}"
                                   TextColor="{StaticResource DmAccentGoldLight}"
                                   Rotation="90"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   TranslationX="2.0"
                                   AutomationProperties.IsInAccessibleTree="False"
                                   InputTransparent="True" />
                        </Border>
                        <BoxView WidthRequest="1" HeightRequest="18"
                                 Color="{StaticResource DmHairlineSolid}"
                                 VerticalOptions="Center" />
                        <!-- Minus and plus are line work, so they are Rectangles centred in the
                             32x32 button rather than text nudged into place by a measured
                             TranslationY. The sizes reproduce what EB Garamond rendered at
                             DmIconSizeXL (20): a minus 10.00 x 1.19 DIU, a plus 9.94 x 9.81 with
                             bars 0.81 and 0.88 thick, 0.85 being used for both. The font's own
                             minus is noticeably heavier than its plus's bars; that difference is
                             reproduced rather than smoothed, because this pass is not meant to
                             change what is on screen. -->
                        <Border x:Name="PopupBtnScaleDown"
                                Style="{StaticResource PopupIconButton}"
                                AutomationId="PopupBtnScaleDown"
                                SemanticProperties.Description="Shrink object"
                                ToolTipProperties.Text="Shrink object">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="{StaticResource DmRadiusTight}" />
                            </Border.StrokeShape>
                            <Rectangle Fill="{StaticResource DmAccentGoldLight}"
                                       StrokeThickness="0"
                                       WidthRequest="10"
                                       HeightRequest="1.45"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       InputTransparent="True" />
                        </Border>
                        <Border x:Name="PopupBtnScaleUp"
                                Style="{StaticResource PopupIconButton}"
                                AutomationId="PopupBtnScaleUp"
                                SemanticProperties.Description="Grow object"
                                ToolTipProperties.Text="Grow object">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="{StaticResource DmRadiusTight}" />
                            </Border.StrokeShape>
                            <Grid InputTransparent="True">
                                <Rectangle Fill="{StaticResource DmAccentGoldLight}"
                                           StrokeThickness="0"
                                           WidthRequest="10"
                                           HeightRequest="1.25"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                <Rectangle Fill="{StaticResource DmAccentGoldLight}"
                                           StrokeThickness="0"
                                           WidthRequest="1.25"
                                           HeightRequest="10"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <BoxView WidthRequest="1" HeightRequest="18"
                                 Color="{StaticResource DmHairlineSolid}"
                                 VerticalOptions="Center" />
                        <Border x:Name="PopupBtnDelete"
                                Style="{StaticResource PopupIconButton}"
                                AutomationId="PopupBtnDelete"
                                SemanticProperties.Description="Delete object"
                                SemanticProperties.Hint="Removes the selected object from the floor"
                                ToolTipProperties.Text="Delete object">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="{StaticResource DmRadiusTight}" />
                            </Border.StrokeShape>
                            <Label Text="&#xE9FC;"
                                   FontFamily="{StaticResource DmFontIcon}"
                                   FontSize="{StaticResource DmIconSizeXL}"
                                   TextColor="{StaticResource DmDestructiveOnPopup}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   AutomationProperties.IsInAccessibleTree="False"
                                   InputTransparent="True" />
                        </Border>
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- Dungeon-level row — always visible, styled like a floor card. Declared as
                 row 0 of the grid above rather than as part of the floor sidebar below, so it is
                 fixed above the scrolling floor list (not a ScrollView child), never scrolls out
                 of view, and survives FloorListContainer's Children.Clear() rebuilds untouched.
                 Its height is whatever the shared row is, which is the map toolbar's height
                 whenever the toolbar is the taller of the two — no HeightRequest, no measured
                 token, and nothing for code-behind to overwrite after the first frame.

                 Same chrome as the map toolbar and the floor cards, and now the same source for
                 it: DmBorderTavernStyle. BackgroundColor is restated because the style inherits
                 Transparent from DmBorderBase. -->
            <Border
                Grid.Row="0"
                Grid.Column="1"
                Style="{StaticResource DmBorderTavernStyle}"
                BackgroundColor="{StaticResource DmSurfaceTavernRaised}"
                Padding="{StaticResource DmPaddingCompact}"
                Margin="0,0,0,4">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource DmSpaceSmall}">
                    <Label
                        Grid.Column="0"
                        Text="{Binding Dungeon.Name}"
                        FontFamily="{StaticResource DmFontTitleStrong}"
                        FontSize="{StaticResource DmFontSizeSubheading}"
                        TextColor="{StaticResource DmAccentGoldLight}"
                        VerticalOptions="Center" />
                    <!-- Padding 4,0 below suppresses the vertical inset on purpose: this
                         button's height is pinned to 22 to match the card row, so any vertical
                         inset would squeeze the glyph rather than grow the button. -->
                    <Button
                        x:Name="DungeonNotebookButton"
                        Grid.Column="1"
                        Padding="4,0"
                        Text="&#xEA8F;"
                        FontFamily="{StaticResource DmFontIcon}"
                        FontSize="{StaticResource DmIconSizeSmall}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource DmTextParchmentMuted}"
                        CornerRadius="{StaticResource DmRadiusTight}"
                        HeightRequest="22"
                        MinimumHeightRequest="22"
                        AutomationId="DungeonNotebookButton"
                        SemanticProperties.Description="Open notebook"
                        SemanticProperties.Hint="Opens this dungeon's notes and lets you rename it"
                        ToolTipProperties.Text="Open notebook"
                        Clicked="OnDungeonNotebookClicked">
                        <Button.Behaviors>
                            <behaviors:HandCursorBehavior />
                        </Button.Behaviors>
                    </Button>
                </Grid>
            </Border>

            <!-- RIGHT SIDEBAR -->
            <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,Auto,*" BackgroundColor="Transparent">

                <!-- Fixed divider between the dungeon card and the scrolling floor list -->
                <controls:DmDivider Grid.Row="0" Margin="0,0,0,4" IconFontSize="{StaticResource DmIconSizeTiny}" />

                <!-- Sidebar header -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <Label
                        Grid.Column="0"
                        Text="FLOORS"
                        FontFamily="{StaticResource DmFontTitle}"
                        FontSize="{StaticResource DmFontSizeHeading}"
                        CharacterSpacing="1"
                        TextColor="{StaticResource DmAccentGoldLight}"
                        VerticalOptions="Center" />
                    <Button
                        Grid.Column="1"
                        Text="+ Add Floor"
                        AutomationId="AddFloorButton"
                        FontFamily="{StaticResource DmFontBody}"
                        FontSize="{StaticResource DmFontSizeBody}"
                        TextColor="{StaticResource DmAccentGoldLight}"
                        BackgroundColor="Transparent"
                        Padding="{StaticResource DmPaddingTight}"
                        Clicked="OnAddFloorClicked">
                        <Button.Behaviors>
                            <behaviors:HandCursorBehavior />
                        </Button.Behaviors>
                    </Button>
                </Grid>

                <!-- Floor list (built in code-behind) -->
                <ScrollView Grid.Row="2">
                    <VerticalStackLayout x:Name="FloorListContainer" Spacing="0" />
                </ScrollView>

            </Grid>
        </Grid>

        <!--
            The notebook floats over the whole page, not just the map: it used to live inside
            MapOverlay (column 0 of the row above), which put it beneath the sidebar (column 1),
            a later sibling that paints on top. Declaring it last here, spanning every row and
            column of the outermost grid, guarantees nothing — sidebar included — can paint over
            it. Secondary object palettes are still appended to MapOverlay's children at runtime,
            but since the notebook is no longer inside MapOverlay at all, that no longer matters;
            this z-order wins regardless. The margin below approximates the map's on-screen
            resting position now that it is no longer computed relative to MapOverlay.
        -->
        <controls:NotebookView
            x:Name="Notebook"
            Grid.Row="0"
            Grid.RowSpan="4"
            IsVisible="False"
            HorizontalOptions="Start"
            VerticalOptions="Start"
            Margin="32,158,0,0" />
    </Grid>
</ContentPage>
