<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DungeonMaster.App.Controls"
    xmlns:behaviors="clr-namespace:DungeonMaster.App.Behaviors"
    xmlns:vm="clr-namespace:DungeonMaster.App.ViewModels"
    xmlns:palette="clr-namespace:DungeonMaster.App.Views.DungeonDetail"
    x:Class="DungeonMaster.App.Views.DungeonDetailPage"
    x:DataType="vm:DungeonDetailViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource DmSurfaceTavern}">

    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="0" Padding="16,12,16,0">

        <!-- Row 0: Top nav bar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
            <Button
                Grid.Column="0"
                Text="&#x2190; Back"
                FontFamily="{StaticResource DmFontBody}"
                FontSize="{StaticResource DmFontSizeBodyLarge}"
                BackgroundColor="Transparent"
                TextColor="{StaticResource DmAccentGoldLight}"
                Padding="0,4"
                Clicked="OnBackClicked">
                <Button.Behaviors>
                    <behaviors:HandCursorBehavior />
                </Button.Behaviors>
            </Button>

            <HorizontalStackLayout
                Grid.Column="1"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="6">
                <Label
                    Text="&#xEA75;"
                    FontFamily="{StaticResource DmFontIcon}"
                    FontSize="{StaticResource DmIconSizeSmall}"
                    TextColor="{StaticResource DmTextTavernMuted}"
                    VerticalOptions="Center" />
                <Label
                    Text="DUNGEON EDITOR"
                    FontFamily="{StaticResource DmFontTitle}"
                    FontSize="{StaticResource DmFontSizeEyebrow}"
                    CharacterSpacing="1.5"
                    TextColor="{StaticResource DmTextTavernMuted}"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Grid Grid.Column="2">
                <Button
                    Text="Start Session"
                    FontFamily="{StaticResource DmFontBody}"
                    FontSize="{StaticResource DmFontSizeBodyLarge}"
                    BackgroundColor="{StaticResource DmConfirm}"
                    TextColor="{StaticResource DmConfirmText}"
                    CornerRadius="3"
                    Padding="36,6,12,6"
                    IsEnabled="{Binding Dungeon.FloorCount, Converter={StaticResource GreaterThanZeroConverter}}">
                    <Button.Behaviors>
                        <behaviors:HandCursorBehavior />
                    </Button.Behaviors>
                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                            Binding="{Binding Dungeon.FloorCount, Converter={StaticResource GreaterThanZeroConverter}}"
                            Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <!-- Crossed-sword icon overlaid on the left of the button -->
                <Label Text="&#xE97D;"
                       FontFamily="{StaticResource DmFontIcon}"
                       FontSize="{StaticResource DmIconSizeMedium}"
                       TextColor="{StaticResource DmConfirmText}"
                       HorizontalOptions="Start"
                       VerticalOptions="Center"
                       Margin="12,0,0,0"
                       InputTransparent="True" />
                <!-- Transparent overlay carries tooltip when button is disabled -->
                <BoxView
                    BackgroundColor="Transparent"
                    IsVisible="{Binding Dungeon.FloorCount, Converter={StaticResource GreaterThanZeroConverter}, ConverterParameter=Invert}"
                    ToolTipProperties.Text="Add at least one floor before starting a session"
                    InputTransparent="False" />
            </Grid>
        </Grid>

        <!-- Row 1: Full-width DmFlagBanner (display-only — renamed via the sidebar card's notebook) -->
        <controls:DmFlagBanner
            x:Name="TitleBanner"
            Grid.Row="1"
            Title="{Binding Dungeon.Name}" />

        <!-- Row 2: Decorative divider between the banner and the map -->
        <controls:DmDivider
            Grid.Row="2"
            Margin="0,6,0,4" />

        <!-- Row 3: Map canvas (left) | Floors sidebar (right) -->
        <Grid Grid.Row="3" ColumnDefinitions="*,300" ColumnSpacing="16">

            <!-- LEFT COLUMN: toolbar (edit mode only) + map canvas -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*">

                <!-- Map toolbar (hidden until a floor is selected) -->
                <Border x:Name="MapToolbar" Grid.Row="0" IsVisible="False"
                        BackgroundColor="{StaticResource DmSurfaceTavernRaised}"
                        Stroke="{StaticResource DmBorderTavernBrush}"
                        StrokeShape="RoundRectangle 3"
                        StrokeThickness="{StaticResource DmStrokeHairline}"
                        Padding="6,4"
                        Margin="0,0,0,4">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">

                        <!-- Left: context-switching area -->
                        <Grid Grid.Column="0">

                            <!-- Floor context: drawing tools. Names are edited in the notebook. -->
                            <Grid x:Name="FloorContextToolbar" IsVisible="True"
                                  ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="4">

                                <!-- Draw tool — active by default -->
                                <Border
                                    x:Name="ToolDrawBorder"
                                    Grid.Column="0"
                                    BackgroundColor="Transparent"
                                    Stroke="{StaticResource DmAccentGoldLight}"
                                    StrokeThickness="{StaticResource DmStrokeHairline}"
                                    StrokeShape="RoundRectangle 3"
                                    Padding="8,4"
                                    ToolTipProperties.Text="Draw area (D)">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnToolDrawClicked" />
                                    </Border.GestureRecognizers>
                                    <Border.Behaviors>
                                        <behaviors:HandCursorBehavior />
                                    </Border.Behaviors>
                                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                        <Label
                                            x:Name="ToolDrawIcon"
                                            Text="&#xEA75;"
                                            FontFamily="{StaticResource DmFontIcon}"
                                            FontSize="{StaticResource DmIconSizeLarge}"
                                            TextColor="{StaticResource DmAccentGoldLight}"
                                            VerticalOptions="Center" />
                                        <Label
                                            x:Name="ToolDrawLabel"
                                            Text="D"
                                            FontFamily="{StaticResource DmFontBody}"
                                            FontSize="{StaticResource DmFontSizeCaption}"
                                            TextColor="{StaticResource DmAccentGoldLight}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Move tool -->
                                <Border
                                    x:Name="ToolMoveBorder"
                                    Grid.Column="1"
                                    BackgroundColor="Transparent"
                                    Stroke="Transparent"
                                    StrokeThickness="{StaticResource DmStrokeHairline}"
                                    StrokeShape="RoundRectangle 3"
                                    Padding="8,4"
                                    ToolTipProperties.Text="Move areas (M)">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnToolMoveClicked" />
                                    </Border.GestureRecognizers>
                                    <Border.Behaviors>
                                        <behaviors:HandCursorBehavior />
                                    </Border.Behaviors>
                                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                        <Label
                                            x:Name="ToolMoveIcon"
                                            Text="&#xE9D9;"
                                            FontFamily="{StaticResource DmFontIcon}"
                                            FontSize="{StaticResource DmIconSizeLarge}"
                                            TextColor="{StaticResource DmTextTavernMuted}"
                                            VerticalOptions="Center" />
                                        <Label
                                            x:Name="ToolMoveLabel"
                                            Text="M"
                                            FontFamily="{StaticResource DmFontBody}"
                                            FontSize="{StaticResource DmFontSizeCaption}"
                                            TextColor="{StaticResource DmTextTavernMuted}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Select tool — click a placed object on the map to select it -->
                                <Border
                                    x:Name="ToolSelectBorder"
                                    Grid.Column="2"
                                    BackgroundColor="Transparent"
                                    Stroke="Transparent"
                                    StrokeThickness="{StaticResource DmStrokeHairline}"
                                    StrokeShape="RoundRectangle 3"
                                    Padding="8,4"
                                    ToolTipProperties.Text="Select area (S)">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnToolSelectClicked" />
                                    </Border.GestureRecognizers>
                                    <Border.Behaviors>
                                        <behaviors:HandCursorBehavior />
                                    </Border.Behaviors>
                                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                        <Label
                                            x:Name="ToolSelectIcon"
                                            Text="&#xE9B6;"
                                            FontFamily="{StaticResource DmFontIcon}"
                                            FontSize="{StaticResource DmIconSizeLarge}"
                                            TextColor="{StaticResource DmTextTavernMuted}"
                                            VerticalOptions="Center" />
                                        <Label
                                            x:Name="ToolSelectLabel"
                                            Text="S"
                                            FontFamily="{StaticResource DmFontBody}"
                                            FontSize="{StaticResource DmFontSizeCaption}"
                                            TextColor="{StaticResource DmTextTavernMuted}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Erase tool — delete an area by clicking it on the canvas -->
                                <Border
                                    x:Name="ToolEraseBorder"
                                    Grid.Column="3"
                                    BackgroundColor="Transparent"
                                    Stroke="Transparent"
                                    StrokeThickness="{StaticResource DmStrokeHairline}"
                                    StrokeShape="RoundRectangle 3"
                                    Padding="8,4"
                                    ToolTipProperties.Text="Erase area (E)">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnToolEraseClicked" />
                                    </Border.GestureRecognizers>
                                    <Border.Behaviors>
                                        <behaviors:HandCursorBehavior />
                                    </Border.Behaviors>
                                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                        <Label
                                            x:Name="ToolEraseIcon"
                                            Text="&#xE936;"
                                            FontFamily="{StaticResource DmFontIcon}"
                                            FontSize="{StaticResource DmIconSizeLarge}"
                                            TextColor="{StaticResource DmTextTavernMuted}"
                                            VerticalOptions="Center" />
                                        <Label
                                            x:Name="ToolEraseLabel"
                                            Text="E"
                                            FontFamily="{StaticResource DmFontBody}"
                                            FontSize="{StaticResource DmFontSizeCaption}"
                                            TextColor="{StaticResource DmTextTavernMuted}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Place tool — place objects anywhere on the floor -->
                                <Border
                                    x:Name="ToolPlaceBorder"
                                    Grid.Column="4"
                                    BackgroundColor="Transparent"
                                    Stroke="Transparent"
                                    StrokeThickness="{StaticResource DmStrokeHairline}"
                                    StrokeShape="RoundRectangle 3"
                                    Padding="8,4"
                                    ToolTipProperties.Text="Place objects (P)">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnToolPlaceClicked" />
                                    </Border.GestureRecognizers>
                                    <Border.Behaviors>
                                        <behaviors:HandCursorBehavior />
                                    </Border.Behaviors>
                                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                        <Label
                                            x:Name="ToolPlaceIcon"
                                            Text="&#xE9B8;"
                                            FontFamily="{StaticResource DmFontIcon}"
                                            FontSize="{StaticResource DmIconSizeLarge}"
                                            TextColor="{StaticResource DmTextTavernMuted}"
                                            VerticalOptions="Center" />
                                        <Label
                                            x:Name="ToolPlaceLabel"
                                            Text="P"
                                            FontFamily="{StaticResource DmFontBody}"
                                            FontSize="{StaticResource DmFontSizeCaption}"
                                            TextColor="{StaticResource DmTextTavernMuted}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Pan tool -->
                                <Border
                                    x:Name="ToolPanBorder"
                                    Grid.Column="5"
                                    BackgroundColor="Transparent"
                                    Stroke="Transparent"
                                    StrokeThickness="{StaticResource DmStrokeHairline}"
                                    StrokeShape="RoundRectangle 3"
                                    Padding="8,4"
                                    ToolTipProperties.Text="Pan / scroll (H)">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnToolPanClicked" />
                                    </Border.GestureRecognizers>
                                    <Border.Behaviors>
                                        <behaviors:HandCursorBehavior />
                                    </Border.Behaviors>
                                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                        <Label
                                            x:Name="ToolPanIcon"
                                            Text="&#xEA78;"
                                            FontFamily="{StaticResource DmFontIcon}"
                                            FontSize="{StaticResource DmIconSizeLarge}"
                                            TextColor="{StaticResource DmTextTavernMuted}"
                                            VerticalOptions="Center" />
                                        <Label
                                            x:Name="ToolPanLabel"
                                            Text="H"
                                            FontFamily="{StaticResource DmFontBody}"
                                            FontSize="{StaticResource DmFontSizeCaption}"
                                            TextColor="{StaticResource DmTextTavernMuted}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>

                            </Grid>

                        </Grid>

                        <!-- Right: always-visible Undo / Save / Discard -->
                        <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">

                            <Button
                                x:Name="UndoButton"
                                Text="&#x21A9; Undo"
                                FontFamily="{StaticResource DmFontBody}"
                                FontSize="{StaticResource DmFontSizeBodySmall}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource DmAccentGoldLight}"
                                BorderColor="Transparent"
                                BorderWidth="1"
                                CornerRadius="3"
                                Padding="8,4"
                                IsEnabled="False"
                                Opacity="0.35"
                                ToolTipProperties.Text="Undo last vertex"
                                Clicked="OnUndoClicked">
                                <Button.Behaviors>
                                    <behaviors:HandCursorBehavior />
                                </Button.Behaviors>
                            </Button>

                        </HorizontalStackLayout>

                    </Grid>
                </Border>

                <!-- Map canvas + zoom overlay -->
                <Grid x:Name="MapOverlay" Grid.Row="1">
                    <GraphicsView
                        x:Name="MapCanvas"
                        StartInteraction="OnMapStartInteraction"
                        DragInteraction="OnMapDragInteraction"
                        EndInteraction="OnMapEndInteraction"
                        MoveHoverInteraction="OnMapMoveHover"
                        EndHoverInteraction="OnMapEndHover">
                        <GraphicsView.GestureRecognizers>
                            <TapGestureRecognizer NumberOfTapsRequired="2" Tapped="OnMapDoubleTapped" />
                            <TapGestureRecognizer Buttons="Secondary" Tapped="OnMapSecondaryTapped" />
                        </GraphicsView.GestureRecognizers>
                    </GraphicsView>
                    <VerticalStackLayout
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        Margin="0,8,12,0"
                        Spacing="2"
                        InputTransparent="False">
                        <!-- Zoom in — upward triangle -->
                        <Grid WidthRequest="42" HeightRequest="36">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnZoomInClicked" />
                            </Grid.GestureRecognizers>
                            <Grid.Behaviors>
                                <behaviors:HandCursorBehavior />
                            </Grid.Behaviors>
                            <Polygon Points="21,1 41,35 1,35"
                                     Fill="{StaticResource DmSurfaceStepper}"
                                     Stroke="{StaticResource DmAccentGoldLight}"
                                     StrokeThickness="{StaticResource DmStrokeHairline}"
                                     HorizontalOptions="Fill"
                                     VerticalOptions="Fill" />
                            <Label Text="+"
                                   FontFamily="{StaticResource DmFontIcon}"
                                   FontSize="{StaticResource DmIconSizeXL}"
                                   TextColor="{StaticResource DmTextTavern}"
                                   WidthRequest="42"
                                   HorizontalOptions="Fill"
                                   HorizontalTextAlignment="Center"
                                   VerticalOptions="End"
                                   Margin="0,0,0,0" />
                        </Grid>
                        <Label x:Name="ZoomPercentLabel"
                               Text="100%"
                               FontFamily="{StaticResource DmFontBody}"
                               FontSize="{StaticResource DmFontSizeBodySmall}"
                               TextColor="{StaticResource DmTextTavern}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               WidthRequest="42" />
                        <!-- Zoom out — downward triangle -->
                        <Grid WidthRequest="42" HeightRequest="36">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnZoomOutClicked" />
                            </Grid.GestureRecognizers>
                            <Grid.Behaviors>
                                <behaviors:HandCursorBehavior />
                            </Grid.Behaviors>
                            <Polygon Points="1,1 41,1 21,35"
                                     Fill="{StaticResource DmSurfaceStepper}"
                                     Stroke="{StaticResource DmAccentGoldLight}"
                                     StrokeThickness="{StaticResource DmStrokeHairline}"
                                     HorizontalOptions="Fill"
                                     VerticalOptions="Fill" />
                            <Label Text="−"
                                   FontFamily="{StaticResource DmFontIcon}"
                                   FontSize="{StaticResource DmIconSizeXL}"
                                   TextColor="{StaticResource DmTextTavern}"
                                   WidthRequest="42"
                                   HorizontalOptions="Fill"
                                   HorizontalTextAlignment="Center"
                                   VerticalOptions="Start"
                                   Margin="0,0,0,0" />
                        </Grid>
                    </VerticalStackLayout>
                    <VerticalStackLayout
                        HorizontalOptions="Start"
                        VerticalOptions="End"
                        Margin="8,0,0,8"
                        Spacing="4">
                        <palette:ControlsPaletteView
                            x:Name="ControlsPalette"
                            IsVisible="False" />
                        <palette:ObjectPaletteView
                            x:Name="ObjectPalette"
                            IsVisible="False" />
                    </VerticalStackLayout>
                    <!-- Object action popup: rotate CCW/CW | resize − /+ | delete -->
                    <Border x:Name="ObjectActionPopup"
                            IsVisible="False"
                            BackgroundColor="{StaticResource DmSurfacePopup}"
                            Stroke="{StaticResource DmBorderPopup}"
                            StrokeThickness="{StaticResource DmStrokeHairline}"
                            StrokeShape="RoundRectangle 3"
                            Padding="4"
                            HorizontalOptions="Start"
                            VerticalOptions="Start">
                        <HorizontalStackLayout Spacing="2">
                            <Border x:Name="PopupBtnCCW"
                                    WidthRequest="32" HeightRequest="32"
                                    BackgroundColor="Transparent"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 2">
                                <Label Text="↺"
                                       FontFamily="{StaticResource DmFontIcon}"
                                       FontSize="{StaticResource DmIconSizeXL}"
                                       TextColor="{StaticResource DmAccentGoldLight}"
                                       Rotation="-90"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       InputTransparent="True" />
                            </Border>
                            <Border x:Name="PopupBtnCW"
                                    WidthRequest="32" HeightRequest="32"
                                    BackgroundColor="Transparent"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 2">
                                <Label Text="↻"
                                       FontFamily="{StaticResource DmFontIcon}"
                                       FontSize="{StaticResource DmIconSizeXL}"
                                       TextColor="{StaticResource DmAccentGoldLight}"
                                       Rotation="90"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       InputTransparent="True" />
                            </Border>
                            <BoxView WidthRequest="1" HeightRequest="18"
                                     Color="{StaticResource DmDivider}"
                                     VerticalOptions="Center" />
                            <Border x:Name="PopupBtnScaleDown"
                                    WidthRequest="32" HeightRequest="32"
                                    BackgroundColor="Transparent"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 2">
                                <Label Text="−"
                                       FontFamily="{StaticResource DmFontIcon}"
                                       FontSize="{StaticResource DmIconSizeXL}"
                                       TextColor="{StaticResource DmAccentGoldLight}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       InputTransparent="True" />
                            </Border>
                            <Border x:Name="PopupBtnScaleUp"
                                    WidthRequest="32" HeightRequest="32"
                                    BackgroundColor="Transparent"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 2">
                                <Label Text="+"
                                       FontFamily="{StaticResource DmFontIcon}"
                                       FontSize="{StaticResource DmIconSizeXL}"
                                       TextColor="{StaticResource DmAccentGoldLight}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       InputTransparent="True" />
                            </Border>
                            <BoxView WidthRequest="1" HeightRequest="18"
                                     Color="{StaticResource DmDivider}"
                                     VerticalOptions="Center" />
                            <Border x:Name="PopupBtnDelete"
                                    WidthRequest="32" HeightRequest="32"
                                    BackgroundColor="Transparent"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 2">
                                <Label Text="&#xE9FC;"
                                       FontFamily="{StaticResource DmFontIcon}"
                                       FontSize="{StaticResource DmIconSizeXL}"
                                       TextColor="{StaticResource DmDestructiveBright}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       InputTransparent="True" />
                            </Border>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </Grid>

            <!-- RIGHT SIDEBAR -->
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*" BackgroundColor="Transparent">

                <!-- Dungeon-level row — always visible, styled like a floor card. Fixed above the
                     scrolling floor list (not a ScrollView child) so it never scrolls out of view
                     and survives FloorListContainer's Children.Clear() rebuilds untouched.
                     HeightRequest below is only a pre-render fallback — the code-behind syncs this
                     card's real height to MapToolbar's measured height once it first renders. -->
                <Border
                    x:Name="DungeonCard"
                    Grid.Row="0"
                    StrokeShape="RoundRectangle 3"
                    StrokeThickness="{StaticResource DmStrokeHairline}"
                    Stroke="{StaticResource DmBorderTavernBrush}"
                    BackgroundColor="{StaticResource DmSurfaceTavernRaised}"
                    Padding="8,8"
                    Margin="0,0,0,4"
                    HeightRequest="41">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <Label
                            Grid.Column="0"
                            Text="{Binding Dungeon.Name}"
                            FontFamily="{StaticResource DmFontTitleStrong}"
                            FontSize="{StaticResource DmFontSizeSubheading}"
                            TextColor="{StaticResource DmAccentGoldLight}"
                            VerticalOptions="Center" />
                        <Button
                            x:Name="DungeonNotebookButton"
                            Grid.Column="1"
                            Text="&#xEA8F;"
                            FontFamily="{StaticResource DmFontIcon}"
                            FontSize="{StaticResource DmIconSizeSmall}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource DmTextParchmentMuted}"
                            Padding="4,0"
                            CornerRadius="2"
                            HeightRequest="22"
                            MinimumHeightRequest="22"
                            ToolTipProperties.Text="Open notebook"
                            Clicked="OnDungeonNotebookClicked">
                            <Button.Behaviors>
                                <behaviors:HandCursorBehavior />
                            </Button.Behaviors>
                        </Button>
                    </Grid>
                </Border>

                <!-- Fixed divider between the dungeon card and the scrolling floor list -->
                <controls:DmDivider Grid.Row="1" Margin="0,0,0,4" IconFontSize="{StaticResource DmIconSizeTiny}" />

                <!-- Sidebar header -->
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <Label
                        Grid.Column="0"
                        Text="FLOORS"
                        FontFamily="{StaticResource DmFontTitle}"
                        FontSize="{StaticResource DmFontSizeHeading}"
                        CharacterSpacing="1"
                        TextColor="{StaticResource DmAccentGoldLight}"
                        VerticalOptions="Center" />
                    <Button
                        Grid.Column="1"
                        Text="+ Add Floor"
                        FontFamily="{StaticResource DmFontBody}"
                        FontSize="{StaticResource DmFontSizeBody}"
                        TextColor="{StaticResource DmAccentGoldLight}"
                        BackgroundColor="Transparent"
                        Padding="4,2"
                        Clicked="OnAddFloorClicked">
                        <Button.Behaviors>
                            <behaviors:HandCursorBehavior />
                        </Button.Behaviors>
                    </Button>
                </Grid>

                <!-- Floor list (built in code-behind) -->
                <ScrollView Grid.Row="3">
                    <VerticalStackLayout x:Name="FloorListContainer" Spacing="0" />
                </ScrollView>

            </Grid>
        </Grid>

        <!--
            The notebook floats over the whole page, not just the map: it used to live inside
            MapOverlay (column 0 of the row above), which put it beneath the sidebar (column 1),
            a later sibling that paints on top. Declaring it last here, spanning every row and
            column of the outermost grid, guarantees nothing — sidebar included — can paint over
            it. Secondary object palettes are still appended to MapOverlay's children at runtime,
            but since the notebook is no longer inside MapOverlay at all, that no longer matters;
            this z-order wins regardless. The margin below approximates the map's on-screen
            resting position now that it is no longer computed relative to MapOverlay.
        -->
        <controls:NotebookView
            x:Name="Notebook"
            Grid.Row="0"
            Grid.RowSpan="4"
            IsVisible="False"
            HorizontalOptions="Start"
            VerticalOptions="Start"
            Margin="32,158,0,0" />
    </Grid>
</ContentPage>
